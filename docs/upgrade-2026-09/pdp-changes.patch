+<section class="container fully-spaced-row--medium sihoo-product-highlights" aria-labelledby="sihoo-highlights-{{ section.id }}">
+  <h2 id="sihoo-highlights-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
+  <div class="sihoo-product-highlights__grid">
+    {%- for block in section.blocks -%}
+      <div class="sihoo-product-highlights__card" {{ block.shopify_attributes }}>
