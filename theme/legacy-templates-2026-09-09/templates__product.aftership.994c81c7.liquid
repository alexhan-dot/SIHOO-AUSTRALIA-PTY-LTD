					{% for media_item in productSelected.media %}
						{% if  productSelected.media.size <= 5 %}
							{% if  media_item.position == 1 %}
							
								<li class="apb_product_detail_swiper_point_active" index={{media_item.position}}></li>

							{% else %}

								<li index={{media_item.position}}></li>

							{% endif %}

						{% else %}
							{% if  media_item.position <= 2 %}
								{% if  media_item.position == 1 %}
									<li class="apb_product_detail_swiper_point_active" index={{media_item.position}}></li>
								{% else %}
									<li index={{media_item.position}}></li>
								{% endif %}
							{% endif %}
							{% if  media_item.position >= mediaPointLengthSecondHalf %}
								<li index={{media_item.position}}></li>
							{% endif %}
						{% endif %}
					{% endfor %}

				</ul>
