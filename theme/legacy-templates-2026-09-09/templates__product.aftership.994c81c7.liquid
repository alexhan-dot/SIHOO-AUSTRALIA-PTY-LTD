					</div>



					{% else %}
					{% if pageType != "product-page" %}
					<a class="splide__slide {{mainImgStatusClassName}}" href="{{shop.url}}{{productSelected.url}}"
						target="_blank">
						<img class="apb_product_detail_swiper_img {{mainImgStatusClassName}}"
							src="{{ media_item | img_url: '1380x1380' }}" alt="{{ media_item.alt }}"
							data-section-id="{{ sectionId }}" product-handle="{{productHandle}}" data-type="img" />
					</a>
					{% else %}
					<img class=" splide__slide apb_product_detail_swiper_img" src="{{ media_item | img_url: '1380x1380' }}"
						alt="{{ media_item.alt }}" data-section-id="{{ sectionId }}"
						product-handle="{{productHandle}}" />
					{% endif %}
					{% endcase %}
					{% endfor %}


				</div>


