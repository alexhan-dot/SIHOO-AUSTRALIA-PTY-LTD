{%- comment -%}
  Video gallery (SIHOO AU PDP library, 2026-09-08).
  Reads product.metafields.custom.videos (product_video metaobjects: title, url, kind, creator, duration, thumbnail)
  plus custom.install_video / custom.adjust_video when set. Groups: product · assembly & adjustment · customers · media.
  Click-to-play (YouTube poster image only until tapped). Renders nothing when there are no videos.
{%- endcomment -%}
{%- liquid
  assign videos = product.metafields.custom.videos.value
  assign install = product.metafields.custom.install_video.value
  assign adjust = product.metafields.custom.adjust_video.value
  assign total = 0
  if videos != blank
    assign total = videos.size
  endif
  if install != blank
    assign total = total | plus: 1
  endif
  if adjust != blank
    assign total = total | plus: 1
  endif
  assign scheme = section.settings.color_scheme
  if scheme == 'auto'
    if product.metafields.custom.color_scheme.value == 'dark'
      assign scheme = 'dark'
    else
      assign scheme = 'light'
    endif
  endif
  assign groups = 'product|Product videos,assembly|Assembly & adjustment,customer|Customers & creators,media_review|Expert reviews' | split: ','
-%}
{%- if total > 0 -%}
<div class="video-gallery video-gallery--{{ scheme }} fully-spaced-row--{{ section.settings.height }}" data-cc-animate>
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <h2 class="video-gallery__heading majortitle in-content h1 align-center">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="video-gallery__text align-center">{{ section.settings.text | escape }}</p>
    {%- endif -%}

    {%- for g in groups -%}
      {%- liquid
        assign gparts = g | split: '|'
        assign gkey = gparts[0]
        assign glabel = gparts[1]
        assign gcount = 0
        capture gcards
          if videos != blank
            for v in videos
              assign vkind = v.kind.value | default: 'product'
              if vkind == 'adjustment'
                assign vkind = 'assembly'
              endif
              if vkind == gkey
                assign gcount = gcount | plus: 1
                render 'video-card', url: v.url.value, title: v.title.value, creator: v.creator.value, duration: v.duration.value, thumb: v.thumbnail.value
              endif
            endfor
          endif
          if gkey == 'assembly'
            if install != blank
              assign gcount = gcount | plus: 1
              render 'video-card', url: install, title: 'Assembly guide', creator: 'SIHOO Australia', duration: blank, thumb: blank
            endif
            if adjust != blank
              assign gcount = gcount | plus: 1
              render 'video-card', url: adjust, title: 'Adjustment guide', creator: 'SIHOO Australia', duration: blank, thumb: blank
            endif
          endif
        endcapture
      -%}
      {%- if gcount > 0 -%}
        <div class="video-gallery__group">
          {%- if section.settings.show_group_labels -%}<h3 class="video-gallery__group-title">{{ glabel }}</h3>{%- endif -%}
          <div class="video-gallery__grid video-gallery__grid--{{ gcount | at_most: 3 }}">{{ gcards }}</div>
        </div>
      {%- endif -%}
    {%- endfor -%}

    {%- if section.settings.channel_url != blank -%}
      <p class="video-gallery__more align-center"><a href="{{ section.settings.channel_url }}" target="_blank" rel="noopener">{{ section.settings.channel_label | default: 'More on our YouTube channel' | escape }}</a></p>
    {%- endif -%}
  </div>
</div>

{% style %}
  #shopify-section-{{ section.id }} .video-gallery { --vg-bg: #fff; --vg-text: #171717; --vg-muted: #5c5c5c; --vg-card: #f4f4f4; }
  #shopify-section-{{ section.id }} .video-gallery--dark { --vg-bg: #111; --vg-text: #fff; --vg-muted: #c9c9c9; --vg-card: #1c1c1c; }
  #shopify-section-{{ section.id }} .video-gallery { background: var(--vg-bg); color: var(--vg-text); }
  #shopify-section-{{ section.id }} .video-gallery__text { max-width: 720px; margin: 0 auto 1.5rem; color: var(--vg-muted); }
  #shopify-section-{{ section.id }} .video-gallery__group { margin-top: 1.5rem; }
  #shopify-section-{{ section.id }} .video-gallery__group-title { font-size: 1.05rem; font-weight: 600; margin: 0 0 0.75rem; color: var(--vg-muted); text-transform: uppercase; letter-spacing: 0.04em; }
  #shopify-section-{{ section.id }} .video-gallery__grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  #shopify-section-{{ section.id }} .vc { background: var(--vg-card); border-radius: 8px; overflow: hidden; }
  #shopify-section-{{ section.id }} .vc__frame { position: relative; aspect-ratio: 16 / 9; background: #000; }
  #shopify-section-{{ section.id }} .vc__frame img, #shopify-section-{{ section.id }} .vc__frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border: 0; }
  #shopify-section-{{ section.id }} .vc__play { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; background: rgba(0,0,0,.15); cursor: pointer; display: flex; align-items: center; justify-content: center; }
  #shopify-section-{{ section.id }} .vc__play svg { width: 56px; height: 56px; }
  #shopify-section-{{ section.id }} .vc__duration { position: absolute; right: 8px; bottom: 8px; background: rgba(0,0,0,.75); color: #fff; font-size: 0.75rem; padding: 0.1rem 0.4rem; border-radius: 4px; }
  #shopify-section-{{ section.id }} .vc__meta { padding: 0.75rem 0.9rem 0.9rem; }
  #shopify-section-{{ section.id }} .vc__title { font-weight: 600; font-size: 0.95rem; line-height: 1.3; margin: 0; }
  #shopify-section-{{ section.id }} .vc__creator { font-size: 0.85rem; color: var(--vg-muted); margin: 0.2rem 0 0; }
  #shopify-section-{{ section.id }} .video-gallery__more { margin-top: 1.5rem; }
  #shopify-section-{{ section.id }} .video-gallery__more a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .video-gallery__grid--2 { grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
    #shopify-section-{{ section.id }} .video-gallery__grid--3 { grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  }
{% endstyle %}

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    root.querySelectorAll('.vc__play').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var frame = btn.parentNode;
        var iframe = document.createElement('iframe');
        iframe.src = btn.dataset.embed + '?autoplay=1&rel=0';
        iframe.allow = 'autoplay; encrypted-media; picture-in-picture';
        iframe.allowFullscreen = true;
        iframe.title = btn.getAttribute('aria-label') || 'Video';
        frame.innerHTML = '';
        frame.appendChild(iframe);
      });
    });
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Video gallery",
  "class": "section-video-gallery",
  "disabled_on": { "groups": ["aside", "header", "footer"] },
  "settings": [
    { "type": "paragraph", "content": "Reads product.metafields.custom.videos (Product video metaobjects) plus custom.install_video / custom.adjust_video. Hidden when there are no videos." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See it in action" },
    { "type": "text", "id": "text", "label": "Intro text", "default": "Real footage from our Australian team, our customers and independent reviewers." },
    { "type": "checkbox", "id": "show_group_labels", "label": "Show group labels", "default": true },
    { "type": "url", "id": "channel_url", "label": "YouTube channel link" },
    { "type": "text", "id": "channel_label", "label": "Channel link label", "default": "More on the SIHOO Australia YouTube channel" },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "auto", "options": [ { "value": "auto", "label": "Auto (product metafield)" }, { "value": "light", "label": "Light" }, { "value": "dark", "label": "Dark" } ] },
    { "type": "select", "id": "height", "label": "Section height", "default": "medium", "options": [ { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" } ] }
  ],
  "presets": [ { "name": "Video gallery" } ]
}
{% endschema %}
