<section class="container fully-spaced-row--medium sihoo-product-highlights" aria-labelledby="sihoo-highlights-{{ section.id }}">
  <h2 id="sihoo-highlights-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
  <div class="sihoo-product-highlights__grid">
    {%- for block in section.blocks -%}
      <div class="sihoo-product-highlights__card" {{ block.shopify_attributes }}>
        <h3>{{ block.settings.heading | escape }}</h3>
        <p>{{ block.settings.text | escape }}</p>
      </div>
    {%- endfor -%}
  </div>
  <p>{{ section.settings.fit_note | escape }}</p>
  <nav aria-label="Product information">
    <a href="#sihoo-product-reviews">Read customer reviews</a>
    <a href="{{ routes.root_url }}pages/contact-us">Get help choosing</a>
    <a href="{{ routes.root_url }}pages/shipping-policy">Delivery information</a>
  </nav>
</section>
{% stylesheet %}
  .sihoo-product-highlights__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin: 24px 0; }
  .sihoo-product-highlights__card { padding: 24px; border: 1px solid #d8d8d8; border-radius: 12px; }
  .sihoo-product-highlights__card h3 { font-size: 1.2em; margin: 0 0 12px; }
  .sihoo-product-highlights__card p { margin: 0; }
  .sihoo-product-highlights nav { display: flex; flex-wrap: wrap; gap: 12px 24px; }
  .sihoo-product-highlights a { text-decoration: underline; text-underline-offset: 3px; }
  .sihoo-product-highlights a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  @media (max-width: 767px) { .sihoo-product-highlights__grid { grid-template-columns: 1fr; gap: 12px; } }
{% endstylesheet %}
{% schema %}
{
  "name": "SIHOO Product highlights",
  "enabled_on": { "templates": ["product"] },
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your fit" },
    { "type": "text", "id": "fit_note", "label": "Fit and variant guidance", "default": "Check your desk clearance and chosen chair options before ordering. Contact our Australian team if you need help choosing." }
  ],
  "blocks": [{ "type": "feature", "name": "Product benefit", "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Verified product benefit" }
  ] }],
  "presets": [{ "name": "SIHOO Product highlights" }]
}
{% endschema %}
