{%- comment -%}
  Product highlights (SIHOO AU PDP library, 2026-09-08).
  Reads product.metafields.custom.highlights (list, up to 6 short bullets) and custom.best_for (list).
  Replaces the block-based sihoo-product-highlights section. Renders nothing when both lists are empty.
{%- endcomment -%}
{%- liquid
  assign highlights = product.metafields.custom.highlights.value
  assign best_for = product.metafields.custom.best_for.value
  assign scheme = section.settings.color_scheme
  if scheme == 'auto'
    if product.metafields.custom.color_scheme.value == 'dark'
      assign scheme = 'dark'
    else
      assign scheme = 'light'
    endif
  endif
  assign icons = section.settings.icons | default: 'check_mark_in_circle' | split: ','
-%}
{%- if highlights != blank or best_for != blank -%}
<div class="product-highlights product-highlights--{{ scheme }} fully-spaced-row--{{ section.settings.height }}" data-cc-animate>
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <h2 class="product-highlights__heading majortitle in-content h1 align-center">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if highlights != blank -%}
      <ul class="product-highlights__grid product-highlights__grid--{{ section.settings.columns }}">
        {%- for item in highlights limit: 6 -%}
          {%- liquid
            assign icon_i = forloop.index0 | modulo: icons.size
            assign icon = icons[icon_i] | strip
            assign parts = item | split: ':'
            if parts.size > 1
              assign h_title = parts.first | strip
              assign h_text = item | remove_first: parts.first | remove_first: ':' | strip
            else
              assign h_title = item | strip
              assign h_text = ''
            endif
          -%}
          <li class="product-highlights__card">
            <span class="product-highlights__icon" aria-hidden="true">{% render 'icon', icon: icon, size: 'medium' %}</span>
            <h3 class="product-highlights__title">{{ h_title | escape }}</h3>
            {%- if h_text != blank -%}<p class="product-highlights__text">{{ h_text | escape }}</p>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if best_for != blank and section.settings.show_best_for -%}
      <p class="product-highlights__best-for">
        <strong>{{ section.settings.best_for_label | default: 'Best for' | escape }}:</strong>
        {{ best_for | join: ' · ' | escape }}
      </p>
    {%- endif -%}
  </div>
</div>

{% style %}
  #shopify-section-{{ section.id }} .product-highlights { --ph-bg: #fff; --ph-text: #171717; --ph-muted: #5c5c5c; --ph-card: #f7f7f7; --ph-accent: #c20000; }
  #shopify-section-{{ section.id }} .product-highlights--dark { --ph-bg: #111; --ph-text: #fff; --ph-muted: #c9c9c9; --ph-card: #1c1c1c; }
  #shopify-section-{{ section.id }} .product-highlights { background: var(--ph-bg); color: var(--ph-text); }
  #shopify-section-{{ section.id }} .product-highlights__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: 0.75rem; }
  #shopify-section-{{ section.id }} .product-highlights__card { background: var(--ph-card); border-radius: 8px; padding: 1.1rem 1.15rem; display: grid; grid-template-columns: auto 1fr; column-gap: 0.85rem; align-items: start; }
  #shopify-section-{{ section.id }} .product-highlights__icon { grid-row: span 2; color: var(--ph-accent); display: inline-flex; margin-top: 0.1rem; }
  #shopify-section-{{ section.id }} .product-highlights__title { font-size: 1.05rem; font-weight: 600; margin: 0; line-height: 1.3; }
  #shopify-section-{{ section.id }} .product-highlights__text { margin: 0.2rem 0 0; font-size: 0.95rem; line-height: 1.5; color: var(--ph-muted); }
  #shopify-section-{{ section.id }} .product-highlights__best-for { text-align: center; margin: 1.25rem 0 0; color: var(--ph-muted); }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .product-highlights__grid--2 { grid-template-columns: repeat(2, 1fr); gap: 1rem; }
    #shopify-section-{{ section.id }} .product-highlights__grid--3 { grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  }
{% endstyle %}
{%- endif -%}

{% schema %}
{
  "name": "Product highlights",
  "class": "section-product-highlights",
  "disabled_on": { "groups": ["aside", "header", "footer"] },
  "settings": [
    { "type": "paragraph", "content": "Reads product.metafields.custom.highlights (up to 6 lines, 'Title: detail' splits into a heading and text) and custom.best_for. Hidden when both are empty." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why you'll like it" },
    { "type": "select", "id": "columns", "label": "Columns (desktop)", "default": "3", "options": [ { "value": "2", "label": "2" }, { "value": "3", "label": "3" } ] },
    { "type": "text", "id": "icons", "label": "Icons (comma-separated, cycled)", "default": "check_mark_in_circle", "info": "Theme icon names, e.g. check_mark_in_circle, award, ruler, heart, feather, leaf" },
    { "type": "checkbox", "id": "show_best_for", "label": "Show 'Best for' line", "default": true },
    { "type": "text", "id": "best_for_label", "label": "'Best for' label", "default": "Best for" },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "auto", "options": [ { "value": "auto", "label": "Auto (product metafield)" }, { "value": "light", "label": "Light" }, { "value": "dark", "label": "Dark" } ] },
    { "type": "select", "id": "height", "label": "Section height", "default": "medium", "options": [ { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" } ] }
  ],
  "presets": [ { "name": "Product highlights" } ]
}
{% endschema %}
