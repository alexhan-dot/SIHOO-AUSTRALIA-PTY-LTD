{%- comment -%}
  Range comparison table (SIHOO AU, 2026-09-09). Lists every product in a chosen collection with the key
  specs.* values in one table – a single crawlable, machine-readable answer to "which SIHOO chair suits me".
  Also emits an ItemList JSON-LD for the listed products. Renders nothing when the collection is empty.
{%- endcomment -%}
{%- liquid
  assign coll = section.settings.collection
  assign items = coll.products
  assign limit = section.settings.limit | default: 30
-%}
{%- if items.size > 0 -%}
<div class="range-compare fully-spaced-row--{{ section.settings.height }}" data-cc-animate>
  <div class="container">
    {%- if section.settings.heading != blank -%}<h2 class="range-compare__heading majortitle in-content h1 align-center">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="range-compare__intro rte align-center">{{ section.settings.text }}</div>{%- endif -%}
    <div class="range-compare__scroll">
      <table class="range-compare__table">
        <thead>
          <tr>
            <th scope="col">Model</th>
            <th scope="col">Series</th>
            <th scope="col">User height</th>
            <th scope="col">Max load</th>
            <th scope="col">Seat height</th>
            <th scope="col">Recline</th>
            <th scope="col">Armrests</th>
            <th scope="col">Lumbar support</th>
            <th scope="col">Warranty</th>
            {%- if section.settings.show_price -%}<th scope="col">Price</th>{%- endif -%}
          </tr>
        </thead>
        <tbody>
          {%- for p in items limit: limit -%}
            {%- liquid
              assign sp = p.metafields.specs
              assign uh = ''
              if sp.user_height_min_cm.value != blank and sp.user_height_max_cm.value != blank
                assign uh = sp.user_height_min_cm.value | append: '–' | append: sp.user_height_max_cm.value | append: ' cm'
              endif
              assign sh = ''
              if sp.seat_height_min_cm.value != blank and sp.seat_height_max_cm.value != blank
                capture a
                  render 'spec-num', value: sp.seat_height_min_cm.value
                endcapture
                capture b
                  render 'spec-num', value: sp.seat_height_max_cm.value
                endcapture
                assign sh = a | append: '–' | append: b | append: ' cm'
              endif
              assign rec = ''
              if sp.recline_positions_deg.value != blank
                assign rec = sp.recline_positions_deg.value | join: '° / ' | append: '°'
              endif
            -%}
            <tr>
              <th scope="row" class="range-compare__model">
                <a href="{{ p.url }}">
                  {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', width: 64, height: 64, alt: p.title }}{%- endif -%}
                  <span>{{ p.title | escape }}</span>
                </a>
              </th>
              <td>{{ sp.family.value | default: '–' | escape }}</td>
              <td>{{ uh | default: '–' }}</td>
              <td>{% if sp.max_load_kg.value != blank %}{{ sp.max_load_kg.value }} kg{% else %}–{% endif %}</td>
              <td>{{ sh | default: '–' }}</td>
              <td>{{ rec | default: '–' }}</td>
              <td>{{ sp.armrest_type.value | default: '–' | escape }}</td>
              <td>{% if sp.lumbar_detail.value != blank %}{{ sp.lumbar_detail.value | newline_to_br | split: '<br />' | join: ' · ' | strip | truncate: 70 | escape }}{% else %}–{% endif %}</td>
              <td>{% if sp.warranty_years.value != blank %}{{ sp.warranty_years.value }} years{% else %}–{% endif %}</td>
              {%- if section.settings.show_price -%}<td>{{ p.price | money }}</td>{%- endif -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
    {%- if section.settings.footnote != blank -%}<p class="range-compare__footnote">{{ section.settings.footnote | escape }}</p>{%- endif -%}
  </div>
</div>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": {{ section.settings.heading | default: coll.title | json }},
  "itemListElement": [
    {%- for p in items limit: limit -%}
    { "@type": "ListItem", "position": {{ forloop.index }}, "url": {{ shop.url | append: p.url | json }}, "name": {{ p.title | json }} }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{% style %}
  #shopify-section-{{ section.id }} .range-compare { background: #fff; color: #171717; }
  #shopify-section-{{ section.id }} .range-compare__intro { max-width: 760px; margin: 0 auto 1.25rem; color: #5c5c5c; }
  #shopify-section-{{ section.id }} .range-compare__scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  #shopify-section-{{ section.id }} .range-compare__table { width: 100%; min-width: 980px; border-collapse: collapse; font-size: 0.92rem; }
  #shopify-section-{{ section.id }} .range-compare__table th, #shopify-section-{{ section.id }} .range-compare__table td { padding: 0.7rem 0.75rem; border-bottom: 1px solid #e6e6e6; text-align: left; vertical-align: middle; }
  #shopify-section-{{ section.id }} .range-compare__table thead th { background: #f7f7f7; font-weight: 600; position: sticky; top: 0; }
  #shopify-section-{{ section.id }} .range-compare__model a { display: flex; align-items: center; gap: 0.6rem; color: inherit; text-decoration: none; font-weight: 600; }
  #shopify-section-{{ section.id }} .range-compare__model img { width: 48px; height: 48px; object-fit: contain; border-radius: 6px; background: #f4f4f4; }
  #shopify-section-{{ section.id }} .range-compare__footnote { margin: 1rem 0 0; font-size: 0.85rem; color: #5c5c5c; text-align: center; }
{% endstyle %}
{%- endif -%}

{% schema %}
{
  "name": "Range comparison",
  "class": "section-range-compare",
  "disabled_on": { "groups": ["aside", "header", "footer"] },
  "settings": [
    { "type": "paragraph", "content": "Lists every product in the chosen collection with its specs.* values. Products without specs show a dash." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Compare every SIHOO chair" },
    { "type": "richtext", "id": "text", "label": "Intro" },
    { "type": "range", "id": "limit", "label": "Maximum products", "min": 5, "max": 50, "step": 5, "default": 30 },
    { "type": "checkbox", "id": "show_price", "label": "Show price column", "default": true },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "All measurements in centimetres and kilograms. Recline shows the lockable positions. Prices in AUD including GST." },
    { "type": "select", "id": "height", "label": "Section height", "default": "medium", "options": [ { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" } ] }
  ],
  "presets": [ { "name": "Range comparison" } ]
}
{% endschema %}
