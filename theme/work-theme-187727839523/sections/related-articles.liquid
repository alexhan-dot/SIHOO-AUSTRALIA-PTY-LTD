{%- comment -%}
  Related articles (SIHOO AU PDP library, 2026-09-08).
  Reads product.metafields.custom.related_articles (list of blog articles). Renders nothing when empty.
  Links the product page to the blog for internal linking / SEO and gives shoppers buying guides.
{%- endcomment -%}
{%- liquid
  assign arts = product.metafields.custom.related_articles.value
  assign n = 0
  if arts != blank
    assign n = arts.size
  endif
-%}
{%- if n > 0 -%}
<div class="related-articles fully-spaced-row--{{ section.settings.height }}" data-cc-animate>
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <h2 class="related-articles__heading majortitle in-content h1 align-center">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <div class="related-articles__grid related-articles__grid--{{ n | at_most: 4 }}">
      {%- for a in arts limit: 4 -%}
        <a class="related-articles__card" href="{{ a.url }}">
          <div class="related-articles__image">
            {%- if a.image -%}{{ a.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 800', sizes: '(min-width: 768px) 25vw, 100vw', alt: a.title }}{%- endif -%}
          </div>
          <span class="related-articles__blog">{{ a.blog.title | escape }}</span>
          <span class="related-articles__title">{{ a.title | escape }}</span>
          {%- if section.settings.show_excerpt and a.excerpt_or_content != blank -%}
            <span class="related-articles__excerpt">{{ a.excerpt_or_content | strip_html | truncatewords: 22 }}</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% style %}
  #shopify-section-{{ section.id }} .related-articles { background: #fff; color: #171717; }
  #shopify-section-{{ section.id }} .related-articles__grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  #shopify-section-{{ section.id }} .related-articles__card { display: flex; flex-direction: column; gap: 0.35rem; text-decoration: none; color: inherit; }
  #shopify-section-{{ section.id }} .related-articles__image { aspect-ratio: 3 / 2; background: #f4f4f4; border-radius: 8px; overflow: hidden; }
  #shopify-section-{{ section.id }} .related-articles__image img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ section.id }} .related-articles__blog { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: #5c5c5c; margin-top: 0.4rem; }
  #shopify-section-{{ section.id }} .related-articles__title { font-weight: 600; line-height: 1.3; }
  #shopify-section-{{ section.id }} .related-articles__excerpt { font-size: 0.9rem; color: #5c5c5c; line-height: 1.45; }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .related-articles__grid--2 { grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
    #shopify-section-{{ section.id }} .related-articles__grid--3 { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
    #shopify-section-{{ section.id }} .related-articles__grid--4 { grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  }
{% endstyle %}
{%- endif -%}

{% schema %}
{
  "name": "Related articles",
  "class": "section-related-articles",
  "disabled_on": { "groups": ["aside", "header", "footer"] },
  "settings": [
    { "type": "paragraph", "content": "Reads product.metafields.custom.related_articles (up to 4). Hidden when empty." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Guides and reviews" },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show excerpt", "default": true },
    { "type": "select", "id": "height", "label": "Section height", "default": "medium", "options": [ { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" } ] }
  ],
  "presets": [ { "name": "Related articles" } ]
}
{% endschema %}
