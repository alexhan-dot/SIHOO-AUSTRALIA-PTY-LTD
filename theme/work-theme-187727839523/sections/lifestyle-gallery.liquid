{%- comment -%}
  Lifestyle gallery (SIHOO AU PDP library, 2026-09-08).
  Reads product.metafields.custom.lifestyle_images (2–6 images). Captions come from each file's alt text.
  Renders nothing when the metafield is empty.
{%- endcomment -%}
{%- liquid
  assign imgs = product.metafields.custom.lifestyle_images.value
  assign n = 0
  if imgs != blank
    assign n = imgs.size
  endif
-%}
{%- if n > 0 -%}
<div class="lifestyle-gallery fully-spaced-row--{{ section.settings.height }}" data-cc-animate>
  <div class="container{% if section.settings.full_width %} container--no-max{% endif %}">
    {%- if section.settings.heading != blank -%}
      <h2 class="lifestyle-gallery__heading majortitle in-content h1 align-center">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <div class="lifestyle-gallery__grid lifestyle-gallery__grid--{{ n | at_most: 3 }}">
      {%- for img in imgs limit: 6 -%}
        <figure class="lifestyle-gallery__item">
          {{ img | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '480, 768, 1024, 1400', sizes: '(min-width: 768px) 33vw, 100vw', alt: img.alt }}
          {%- if section.settings.show_captions and img.alt != blank -%}<figcaption>{{ img.alt | escape }}</figcaption>{%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
</div>

{% style %}
  #shopify-section-{{ section.id }} .lifestyle-gallery__grid { display: grid; grid-template-columns: 1fr; gap: 0.75rem; }
  #shopify-section-{{ section.id }} .lifestyle-gallery__item { margin: 0; position: relative; border-radius: 8px; overflow: hidden; aspect-ratio: {{ section.settings.ratio | default: '4 / 3' }}; background: #f4f4f4; }
  #shopify-section-{{ section.id }} .lifestyle-gallery__item img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ section.id }} .lifestyle-gallery__item figcaption { position: absolute; left: 0; right: 0; bottom: 0; padding: 0.75rem 1rem; color: #fff; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.85rem; background: linear-gradient(to top, rgba(0,0,0,.6), rgba(0,0,0,0)); }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .lifestyle-gallery__grid--2 { grid-template-columns: repeat(2, 1fr); gap: 1rem; }
    #shopify-section-{{ section.id }} .lifestyle-gallery__grid--3 { grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  }
{% endstyle %}
{%- endif -%}

{% schema %}
{
  "name": "Lifestyle gallery",
  "class": "section-lifestyle-gallery",
  "disabled_on": { "groups": ["aside", "header", "footer"] },
  "settings": [
    { "type": "paragraph", "content": "Reads product.metafields.custom.lifestyle_images. Captions use each image's alt text. Hidden when empty." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for the way you work" },
    { "type": "checkbox", "id": "show_captions", "label": "Show captions (alt text)", "default": true },
    { "type": "select", "id": "ratio", "label": "Image shape", "default": "4 / 3", "options": [ { "value": "4 / 3", "label": "4:3" }, { "value": "3 / 2", "label": "3:2" }, { "value": "1 / 1", "label": "Square" } ] },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": false },
    { "type": "select", "id": "height", "label": "Section height", "default": "medium", "options": [ { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" } ] }
  ],
  "presets": [ { "name": "Lifestyle gallery" } ]
}
{% endschema %}
