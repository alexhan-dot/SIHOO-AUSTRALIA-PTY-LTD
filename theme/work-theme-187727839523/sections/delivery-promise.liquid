{%- comment -%}
  Delivery promise (SIHOO AU PDP library, 2026-09-08).
  Four Australian warehouses → typical delivery windows by state. All copy lives in section settings/blocks
  (store-level facts, not product copy). Add a "city" block per warehouse.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<div class="delivery-promise fully-spaced-row--{{ section.settings.height }}" data-cc-animate>
  <div class="container">
    <div class="delivery-promise__head">
      {%- if section.settings.heading != blank -%}<h2 class="delivery-promise__heading majortitle in-content h1">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="delivery-promise__text rte">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <ul class="delivery-promise__grid">
      {%- for block in section.blocks -%}
        <li class="delivery-promise__city" {{ block.shopify_attributes }}>
          <span class="delivery-promise__icon" aria-hidden="true">{% render 'icon', icon: 'map_pin', size: 'small' %}</span>
          <span class="delivery-promise__name">{{ block.settings.city | escape }}</span>
          <span class="delivery-promise__serves">{{ block.settings.serves | escape }}</span>
          <span class="delivery-promise__eta">{{ block.settings.eta | escape }}</span>
        </li>
      {%- endfor -%}
    </ul>
    {%- if section.settings.footnote != blank -%}<p class="delivery-promise__footnote">{{ section.settings.footnote | escape }}</p>{%- endif -%}
    {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
      <p class="delivery-promise__link"><a href="{{ section.settings.link_url }}">{{ section.settings.link_label | escape }}</a></p>
    {%- endif -%}
  </div>
</div>

{% style %}
  #shopify-section-{{ section.id }} .delivery-promise { background: #fff; color: #171717; }
  #shopify-section-{{ section.id }} .delivery-promise__head { text-align: center; max-width: 760px; margin: 0 auto 1.5rem; }
  #shopify-section-{{ section.id }} .delivery-promise__text { color: #5c5c5c; }
  #shopify-section-{{ section.id }} .delivery-promise__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem; }
  #shopify-section-{{ section.id }} .delivery-promise__city { border: 1px solid #e6e6e6; border-radius: 8px; padding: 1rem; display: grid; grid-template-columns: auto 1fr; column-gap: 0.6rem; row-gap: 0.15rem; align-items: start; }
  #shopify-section-{{ section.id }} .delivery-promise__icon { grid-row: span 3; color: #c20000; margin-top: 0.15rem; }
  #shopify-section-{{ section.id }} .delivery-promise__name { font-weight: 600; font-size: 1.05rem; }
  #shopify-section-{{ section.id }} .delivery-promise__serves { font-size: 0.85rem; color: #5c5c5c; }
  #shopify-section-{{ section.id }} .delivery-promise__eta { font-size: 0.95rem; font-weight: 600; color: #1f9d55; }
  #shopify-section-{{ section.id }} .delivery-promise__footnote { margin: 1rem 0 0; text-align: center; font-size: 0.85rem; color: #5c5c5c; }
  #shopify-section-{{ section.id }} .delivery-promise__link { text-align: center; margin: 0.5rem 0 0; }
  #shopify-section-{{ section.id }} .delivery-promise__link a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  @media (min-width: 768px) { #shopify-section-{{ section.id }} .delivery-promise__grid { grid-template-columns: repeat(4, 1fr); gap: 1rem; } }
{% endstyle %}
{%- endif -%}

{% schema %}
{
  "name": "Delivery promise",
  "class": "section-delivery-promise",
  "disabled_on": { "groups": ["aside", "header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shipped from the warehouse nearest you" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>SIHOO Australia holds stock in four warehouses so most orders leave the same or next business day and arrive within 1–5 business days.</p>" },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "Delivery windows are typical courier times after dispatch. Regional and remote addresses can take longer; we will send tracking as soon as your chair ships." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Read our delivery policy" },
    { "type": "url", "id": "link_url", "label": "Link URL" },
    { "type": "select", "id": "height", "label": "Section height", "default": "medium", "options": [ { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" } ] }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "city",
      "name": "Warehouse",
      "settings": [
        { "type": "text", "id": "city", "label": "City", "default": "Sydney" },
        { "type": "text", "id": "serves", "label": "Serves", "default": "NSW · ACT" },
        { "type": "text", "id": "eta", "label": "Typical delivery", "default": "1–3 business days" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Delivery promise",
      "blocks": [
        { "type": "city", "settings": { "city": "Sydney", "serves": "NSW · ACT", "eta": "1–3 business days" } },
        { "type": "city", "settings": { "city": "Melbourne", "serves": "VIC · TAS", "eta": "1–3 business days" } },
        { "type": "city", "settings": { "city": "Brisbane", "serves": "QLD · northern NSW", "eta": "1–3 business days" } },
        { "type": "city", "settings": { "city": "Perth", "serves": "WA", "eta": "1–3 business days" } }
      ]
    }
  ]
}
{% endschema %}
