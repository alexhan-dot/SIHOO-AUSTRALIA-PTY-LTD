{%- comment -%}
  BreadcrumbList JSON-LD for every indexable template (SIHOO AU audit A8, 2026-09-07).
  Rendered from layout/theme.liquid <head>. The visible breadcrumbs snippet
  (snippets/breadcrumbs.liquid) no longer outputs JSON-LD, so there is exactly one
  BreadcrumbList per page regardless of which product section is in use.
{%- endcomment -%}
{%- liquid
  assign crumbs_ok = false
  if template.name == 'product' or template.name == 'collection' or template.name == 'article' or template.name == 'blog' or template.name == 'page'
    assign crumbs_ok = true
  endif
  if template.name == 'collection' and collection.handle == blank
    assign crumbs_ok = false
  endif
  if template.name == 'page' and page.handle == blank
    assign crumbs_ok = false
  endif
-%}
{%- if crumbs_ok -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | append: '/' | json }} }
    {%- if template.name == 'collection' -%}
      ,{ "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ shop.url | append: collection.url | json }} }
    {%- elsif template.name == 'product' -%}
      {%- liquid
        comment
          SIHOO AU 2026-09-08: when the product is opened directly (no /collections/x/products/y URL),
          fall back to the product's first "real" collection so Home > Collection > Product is always shown.
        endcomment
        assign crumb_collection = collection
        if crumb_collection == blank or crumb_collection.handle == blank
          for pc in product.collections
            if pc.handle == 'all' or pc.handle == 'frontpage' or pc.handle contains 'sale' or pc.handle contains 'new-arrival' or pc.handle contains 'eofy' or pc.handle contains 'clearance'
              continue
            endif
            assign crumb_collection = pc
            break
          endfor
        endif
      -%}
      {%- if crumb_collection and crumb_collection.handle != blank -%}
        ,{ "@type": "ListItem", "position": 2, "name": {{ crumb_collection.title | json }}, "item": {{ shop.url | append: crumb_collection.url | json }} }
        ,{ "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ shop.url | append: product.url | json }} }
      {%- else -%}
        ,{ "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ shop.url | append: product.url | json }} }
      {%- endif -%}
    {%- elsif template.name == 'blog' -%}
      ,{ "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ shop.url | append: blog.url | json }} }
    {%- elsif template.name == 'article' -%}
      ,{ "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ shop.url | append: blog.url | json }} }
      ,{ "@type": "ListItem", "position": 3, "name": {{ article.title | json }}, "item": {{ shop.url | append: article.url | json }} }
    {%- elsif template.name == 'page' -%}
      ,{ "@type": "ListItem", "position": 2, "name": {{ page.title | json }}, "item": {{ shop.url | append: page.url | json }} }
    {%- endif %}
  ]
}
</script>
{%- endif -%}
