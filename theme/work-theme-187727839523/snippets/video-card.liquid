{%- comment -%} One click-to-play YouTube card. Params: url, title, creator, duration, thumb (image or blank) {%- endcomment -%}
{%- liquid
  assign yid = blank
  if url != blank
    assign v = url | strip
    if v contains 'youtu.be/'
      assign yid = v | split: 'youtu.be/' | last | split: '?' | first | split: '&' | first
    elsif v contains 'youtube.com/shorts/'
      assign yid = v | split: 'shorts/' | last | split: '?' | first
    elsif v contains 'youtube.com'
      assign yid = v | split: 'v=' | last | split: '&' | first
    endif
  endif
-%}
{%- if yid != blank -%}
<div class="vc">
  <div class="vc__frame">
    {%- if thumb != blank -%}
      {{ thumb | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 800', sizes: '(min-width: 768px) 33vw, 100vw', alt: title }}
    {%- else -%}
      <img src="https://i.ytimg.com/vi/{{ yid }}/hqdefault.jpg" alt="{{ title | escape }}" loading="lazy" width="480" height="360">
    {%- endif -%}
    <button type="button" class="vc__play" data-embed="https://www.youtube-nocookie.com/embed/{{ yid }}" aria-label="Play: {{ title | escape }}">
      <svg viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="30" fill="rgba(0,0,0,.55)"/><path d="M26 20l18 12-18 12z" fill="#fff"/></svg>
    </button>
    {%- if duration != blank -%}<span class="vc__duration">{{ duration | escape }}</span>{%- endif -%}
  </div>
  <div class="vc__meta">
    <p class="vc__title">{{ title | escape }}</p>
    {%- if creator != blank -%}<p class="vc__creator">{{ creator | escape }}</p>{%- endif -%}
  </div>
</div>
{%- endif -%}
