{%- comment -%}
  Product structured data for SIHOO Australia (audit A3, 2026-09-07; enriched 2026-09-09).
  Replaces `{{ product | structured_data }}` so that the ProductGroup carries:
  - aggregateRating from Shopify's standard reviews.rating / reviews.rating_count metafields (Loox sync)
  - a fixed brand ("SIHOO", or "Desker" for desks) instead of the vendor string
  - AU-specific Offer data Google requires for merchant listings: free AU shipping with delivery
    time, 30-day free return policy, condition, seller, GTIN/SKU
  - additionalProperty from specs.*, material, isSimilarTo (compare_products) and a VideoObject for the hero video
  Parameters: product, current_variant
{%- endcomment -%}
{%- liquid
  assign product_url = shop.url | append: product.url
  assign brand_name = 'SIHOO'
  if product.vendor contains 'Desker'
    assign brand_name = 'Desker'
  endif
  assign rating_count = product.metafields.reviews.rating_count | plus: 0
  assign rating_obj = product.metafields.reviews.rating.value
  assign sd_description = product.description | strip_html | strip_newlines | strip | truncate: 5000
  if sd_description == blank
    assign sd_description = product.metafields.global.description_tag | default: page_description
  endif
  assign price_valid_until = 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d'
  assign sp = product.metafields.specs
  assign cmp = product.metafields.custom.compare_products.value
  assign hero_url = product.metafields.custom.hero_video.value
  assign hero_file = product.metafields.custom.hero_video_file.value
  assign hero_yid = blank
  if hero_url != blank
    assign hv = hero_url | strip
    if hv contains 'youtu.be/'
      assign hero_yid = hv | split: 'youtu.be/' | last | split: '?' | first | split: '&' | first
    elsif hv contains 'youtube.com'
      assign hero_yid = hv | split: 'v=' | last | split: '&' | first
    endif
  endif
  assign props = ''
  if sp.max_load_kg.value != blank
    assign props = props | append: ',{"@type":"PropertyValue","name":"Maximum load","value":' | append: sp.max_load_kg.value | append: ',"unitCode":"KGM"}'
  endif
  if sp.user_height_min_cm.value != blank and sp.user_height_max_cm.value != blank
    assign props = props | append: ',{"@type":"PropertyValue","name":"Recommended user height","value":"' | append: sp.user_height_min_cm.value | append: '–' | append: sp.user_height_max_cm.value | append: ' cm"}'
  endif
  if sp.seat_height_min_cm.value != blank and sp.seat_height_max_cm.value != blank
    assign props = props | append: ',{"@type":"PropertyValue","name":"Seat height","value":"' | append: sp.seat_height_min_cm.value | append: '–' | append: sp.seat_height_max_cm.value | append: ' cm"}'
  endif
  if sp.recline_positions_deg.value != blank
    assign rec = sp.recline_positions_deg.value | join: '° / ' | append: '°' | json
    assign props = props | append: ',{"@type":"PropertyValue","name":"Recline","value":' | append: rec | append: '}'
  endif
  if sp.armrest_type.value != blank
    assign arm_j = sp.armrest_type.value | json
    assign props = props | append: ',{"@type":"PropertyValue","name":"Armrests","value":' | append: arm_j | append: '}'
  endif
  if sp.lumbar_detail.value != blank
    assign lum_j = sp.lumbar_detail.value | strip_newlines | json
    assign props = props | append: ',{"@type":"PropertyValue","name":"Lumbar support","value":' | append: lum_j | append: '}'
  endif
  if sp.certifications.value != blank
    assign certs = sp.certifications.value | join: ', ' | json
    assign props = props | append: ',{"@type":"PropertyValue","name":"Certifications","value":' | append: certs | append: '}'
  endif
  if sp.warranty_years.value != blank
    assign props = props | append: ',{"@type":"PropertyValue","name":"Warranty","value":"' | append: sp.warranty_years.value | append: ' years"}'
  endif
  assign has_color = false
  for option in product.options
    assign option_down = option | downcase
    if option_down == 'color' or option_down == 'colour'
      assign has_color = true
    endif
  endfor
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "ProductGroup",
  "@id": {{ product_url | append: '#product' | json }},
  "name": {{ product.title | json }},
  "description": {{ sd_description | json }},
  "url": {{ product_url | json }},
  "brand": { "@type": "Brand", "name": {{ brand_name | json }} },
  "productGroupID": {{ product.id | json }},
  "category": {{ product.type | json }},
  "image": [{% for image in product.images limit: 8 %}{{ image | image_url: width: 1600 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],
  {%- if has_color %}
  "variesBy": ["https://schema.org/color"],
  {%- endif %}
  {%- if rating_count > 0 and rating_obj.rating != blank %}
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ rating_obj.rating | json }},
    "bestRating": {{ rating_obj.scale_max | default: 5 | json }},
    "worstRating": {{ rating_obj.scale_min | default: 1 | json }},
    "reviewCount": {{ rating_count }}
  },
  {%- endif %}
  "manufacturer": { "@type": "Organization", "name": {{ brand_name | json }} },
  "audience": { "@type": "PeopleAudience", "geographicArea": { "@type": "Country", "name": "Australia" } },
  {%- if sp.mesh_material.value != blank %}
  "material": {{ sp.mesh_material.value | strip_newlines | json }},
  {%- endif %}
  {%- if props != blank %}
  "additionalProperty": [{{ props | remove_first: ',' }}],
  {%- endif %}
  {%- if cmp != blank %}
  "isSimilarTo": [{% for cp in cmp limit: 3 %}{ "@type": "Product", "name": {{ cp.title | json }}, "url": {{ shop.url | append: cp.url | json }} }{% unless forloop.last %},{% endunless %}{% endfor %}],
  {%- endif %}
  {%- if hero_file != blank and hero_file.sources.size > 0 %}
  "subjectOf": {
    "@type": "VideoObject",
    "name": {{ product.title | append: ' – product video' | json }},
    "description": {{ sd_description | truncate: 300 | json }},
    "thumbnailUrl": {{ hero_file.preview_image | image_url: width: 1280 | prepend: 'https:' | json }},
    "uploadDate": {{ product.published_at | date: '%Y-%m-%d' | json }},
    "contentUrl": {{ hero_file.sources.last.url | prepend: 'https:' | json }}
  },
  {%- elsif hero_yid != blank %}
  "subjectOf": {
    "@type": "VideoObject",
    "name": {{ product.title | append: ' – product video' | json }},
    "description": {{ sd_description | truncate: 300 | json }},
    "thumbnailUrl": {{ 'https://i.ytimg.com/vi/' | append: hero_yid | append: '/hqdefault.jpg' | json }},
    "uploadDate": {{ product.published_at | date: '%Y-%m-%d' | json }},
    "embedUrl": {{ 'https://www.youtube.com/embed/' | append: hero_yid | json }}
  },
  {%- endif %}
  "hasVariant": [
    {%- for variant in product.variants %}
    {
      "@type": "Product",
      "@id": {{ product_url | append: '?variant=' | append: variant.id | append: '#variant' | json }},
      "name": {% if variant.title == 'Default Title' %}{{ product.title | json }}{% else %}{{ product.title | append: ' - ' | append: variant.title | json }}{% endif %},
      "sku": {{ variant.sku | json }},
      {%- if variant.barcode != blank %}
      "gtin": {{ variant.barcode | json }},
      {%- endif %}
      {%- if has_color %}
      "color": {{ variant.option1 | json }},
      {%- endif %}
      "image": {% if variant.image %}{{ variant.image | image_url: width: 1600 | prepend: 'https:' | json }}{% else %}{{ product.featured_image | image_url: width: 1600 | prepend: 'https:' | json }}{% endif %},
      "offers": {
        "@type": "Offer",
        "@id": {{ product_url | append: '?variant=' | append: variant.id | append: '#offer' | json }},
        "url": {{ product_url | append: '?variant=' | append: variant.id | json }},
        "price": {{ variant.price | money_without_currency | remove: ',' | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "priceValidUntil": {{ price_valid_until | json }},
        "availability": {% if variant.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %},
        "itemCondition": "https://schema.org/NewCondition",
        "seller": { "@type": "Organization", "name": "SIHOO Australia" },
        "shippingDetails": {
          "@type": "OfferShippingDetails",
          "shippingRate": { "@type": "MonetaryAmount", "value": 0, "currency": "AUD" },
          "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "AU" },
          "deliveryTime": {
            "@type": "ShippingDeliveryTime",
            "handlingTime": { "@type": "QuantitativeValue", "minValue": 0, "maxValue": 1, "unitCode": "DAY" },
            "transitTime": { "@type": "QuantitativeValue", "minValue": 1, "maxValue": 7, "unitCode": "DAY" }
          }
        },
        "hasMerchantReturnPolicy": {
          "@type": "MerchantReturnPolicy",
          "applicableCountry": "AU",
          "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
          "merchantReturnDays": 30,
          "returnMethod": "https://schema.org/ReturnByMail",
          "returnFees": "https://schema.org/FreeReturn",
          "merchantReturnLink": "https://sihoo.com.au/pages/returns"
        }
      }
    }{% unless forloop.last %},{% endunless %}
    {%- endfor %}
  ]
}
</script>
