    "custom_liquid_iYXdTf": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "show_space": true,
        "code": "<style>\n.c300-compare {\n  max-width: 1280px;\n  margin: 0 auto;\n  padding: 40px 20px;\n  font-family: inherit;\n}\n\n.c300-grid {\n  display: grid;\n  grid-template-columns: 1fr 1.15fr 1.15fr;\n  align-items: stretch;\n  background: #fff;\n}\n\n.c300-cell {\n  padding: 28px 24px;\n  border-bottom: 1px solid #e5e5e5;\n}\n\n.c300-heading {\n  display: flex;\n  align-items: center;\n  font-size: 24px;\n  font-weight: 700;\n  color: #111;\n}\n\n.c300-product {\n  text-align: center;\n  position: relative;\n}\n\n.c300-highlight {\n  background: #dff8fb;\n}\n\n.c300-product img {\n  max-width: 220px;\n  width: 100%;\n  height: auto;\n  margin-bottom: 20px;\n}\n\n.c300-product-title {\n  font-size: 20px;\n  font-weight: 700;\n  color: #111;\n}\n\n.c300-product-title.muted {\n  color: #777;\n}\n\n.c300-badge {\n  position: absolute;\n  top: 16px;\n  right: 16px;\n  background: #ff4b00;\n  color: #fff;\n  font-size: 12px;\n  font-weight: 700;\n  padding: 6px 12px;\n  border-radius: 999px;\n}\n\n.c300-label {\n  font-weight: 700;\n  color: #111;\n  display: flex;\n  align-items: center;\n}\n\n.c300-text {\n  font-size: 15px;\n  line-height: 1.55;\n  color: #111;\n  text-align: center;\n}\n\n.c300-text strong {\n  font-weight: 700;\n}\n\n.c300-muted {\n  color: #666;\n}\n\n@media screen and (max-width: 768px) {\n  .c300-grid {\n    display: block;\n  }\n\n  .c300-heading {\n    font-size: 22px;\n    padding: 20px 0;\n  }\n\n  .c300-cell {\n    padding: 22px 18px;\n  }\n\n  .c300-product {\n    border-bottom: 1px solid #e5e5e5;\n  }\n\n  .c300-label {\n    background: #f7f7f7;\n    font-size: 16px;\n  }\n\n  .c300-text {\n    text-align: left;\n  }\n\n  .c300-product img {\n    max-width: 180px;\n  }\n}\n</style>\n\n<section class=\"c300-compare\">\n  <div class=\"c300-grid\">\n\n    <div class=\"c300-cell c300-heading\">\n      Why Upgrade to Pro V2?\n    </div>\n\n    <div class=\"c300-cell c300-product c300-highlight\">\n      <span class=\"c300-badge\">NEW!</span>\n      <img src=\"https://cdn.shopify.com/s/files/1/0509/7819/3602/files/Untitled_design_1.png?v=1781238603\" alt=\"Doro C300 Pro V2 ergonomic chair\">\n      <div class=\"c300-product-title\">Doro C300 Pro V2</div>\n    </div>\n\n    <div class=\"c300-cell c300-product\">\n      <img src=\"https://sihoo.com.au/cdn/shop/files/c300-white-footrest-1.jpg?v=1774886858&width=5000\" alt=\"Doro C300 Pro ergonomic chair\">\n      <div class=\"c300-product-title muted\">Doro C300 Pro</div>\n    </div>\n\n    <div class=\"c300-cell c300-label\">Support System</div>\n    <div class=\"c300-cell c300-text c300-highlight\">\n      <strong>DynaCore™ Full-Body Support</strong><br>\n      Keeps your headrest, backrest, lumbar support and armrests working together to provide consistent ergonomic support as your posture changes.\n    </div>\n    <div class=\"c300-cell c300-text c300-muted\">\n      <strong>Multi-Point Ergonomic Support</strong><br>\n      Provides balanced support across key body zones for everyday comfort while working or studying.\n    </div>\n\n    <div class=\"c300-cell c300-label\">Lumbar & Sacral Fit</div>\n    <div class=\"c300-cell c300-text c300-highlight\">\n      <strong>Domino™ Sacral-Lumbar Support</strong><br>\n      Provides targeted support across the lumbar and sacral regions for improved comfort.\n    </div>\n    <div class=\"c300-cell c300-text c300-muted\">\n      <strong>Self-Adaptive Dynamic Lumbar Support</strong><br>\n      Responsive lumbar support that adjusts to changes in posture for everyday ergonomic comfort.\n    </div>\n\n    <div class=\"c300-cell c300-label\">Backrest</div>\n    <div class=\"c300-cell c300-text c300-highlight\">\n      <strong>SyncroFlex™ Back-Glide System</strong><br>\n      Moves naturally with your posture to create a more personalised fit from the moment you sit down.\n    </div>\n    <div class=\"c300-cell c300-text c300-muted\">\n      <strong>Flexible Ergonomic Backrest</strong><br>\n      Contours to your back to provide comfortable support while sitting upright or reclining.\n    </div>\n\n    <div class=\"c300-cell c300-label\">Armrests</div>\n    <div class=\"c300-cell c300-text c300-highlight\">\n      <strong>8D Bionic Armrests</strong><br>\n      Expanded adjustment options help keep your arms comfortably supported across a wider range of work and relaxation positions.\n    </div>\n    <div class=\"c300-cell c300-text c300-muted\">\n      <strong>4D Coordinated Armrests</strong><br>\n      Adjustable armrests designed to support different tasks and sitting positions throughout the day.\n    </div>\n\n    <div class=\"c300-cell c300-label\">Seat Fit</div>\n    <div class=\"c300-cell c300-text c300-highlight\">\n      <strong>Pressure-Relief Seat with 1.6\" Depth Adjustment</strong><br>\n      Adjustable seat depth helps create a more personalised fit while promoting better leg support during extended sitting.\n    </div>\n    <div class=\"c300-cell c300-text c300-muted\">\n      <strong>Waterfall Mesh Seat</strong><br>\n      Breathable waterfall mesh seat designed to provide balanced comfort for everyday use.\n    </div>\n\n  </div>\n</section>"
      }
    },
