    "custom_multi_column_WWXqNc": {
      "type": "custom-multi-column",
      "blocks": {
        "column_HhQzUb": {
          "type": "column",
          "settings": {
            "hide_image": true,
            "title": "",
            "description": "<h3>Overview</h3><p>The SIHOO Doro C300 Pro V2 combines intelligent ergonomic design with premium adjustability to deliver personalised support throughout your day. Featuring the advanced DynaCore™ Full-Body Support System, it adapts naturally to your movements while helping promote better posture, improved comfort and reduced fatigue during long hours of work, study or gaming.<br/><br/><strong>Product Name:</strong> SIHOO Doro C300 Pro V2 Ergonomic Office Chair<br/><br/><strong>Support System:</strong> DynaCore™ Full-Body Support System<br/><br/><strong>Materials:</strong> Premium elastic mesh back and seat with soft PU-coated armrests<br/><br/><strong>Assembly:</strong> Simple assembly required<br/><br/><strong>Net Weight: </strong>59.64 lbs<br/><br/><strong>Gross Weight: </strong>75.22 lbs<br/><br/><strong>Warranty</strong>: (3) years warranty</p>",
            "note": ""
          }
        },
        "column_UkeDxJ": {
          "type": "column",
          "settings": {
            "hide_image": false,
            "image": "shopify://shop_images/1_5d9bb365-c711-433a-bc10-b417fe998ae0.jpg",
            "title": "",
            "description": "<p><strong>Backrest Height:</strong> 52.1 cm – 59.2 cm (20.5\" – 23.3\")</p><p><strong>Seat Depth:</strong> 42.9 cm – 47.0 cm (16.9\" – 18.5\")</p><p><strong>Seat Width:</strong> 52.1 cm (20.5\")</p><p><strong>Maximum Load:</strong> 150 kg (330 lbs)</p><p><strong>Armrests:</strong> 8D Bionic Armrests</p><p><strong>Backrest:</strong> SyncroFlex™ Back-Glide System</p><p><strong>Lumbar Support:</strong> Domino™ Sacral-Lumbar Support</p><p><strong>Recline Angles:</strong> 105°, 120° and 135°</p><p><strong>Seat Adjustment:</strong> 4 cm (1.6\") Seat Depth Adjustment</p>",
            "note": ""
          }
        },
        "column_mJUJWG": {
          "type": "column",
          "settings": {
            "hide_image": false,
            "image": "shopify://shop_images/2_695eede1-2dad-4265-9a55-fd00c1e7cd3a.jpg",
            "title": "",
            "description": "<h3>Ergonomic Tech</h3><p><a href=\"https://youtu.be/d3BINOBo7Qs\" target=\"_blank\" title=\"https://youtu.be/d3BINOBo7Qs\">Installation Guide</a></p><p><a href=\"https://youtu.be/nnSIia7XDSA\" target=\"_blank\" title=\"https://youtu.be/nnSIia7XDSA\">Adjustment Guide</a></p><p><a href=\"https://cdn.shopify.com/s/files/1/0509/7819/3602/files/S100_c211194c-b449-45e0-92ef-7f337fcc575c.pdf?v=1776940592\" target=\"_blank\" title=\"https://cdn.shopify.com/s/files/1/0509/7819/3602/files/S100_c211194c-b449-45e0-92ef-7f337fcc575c.pdf?v=1776940592\">Download Manual</a></p>",
