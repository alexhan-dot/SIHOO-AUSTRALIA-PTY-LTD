        "question_3eUC8X",
        "question_clean"
      ],
      "settings": {
        "title": "3. How to Adjust a SIHOO Chair"
      }
    },
    "collapsible_tabs_DAwCYY": {
      "type": "collapsible-tabs",
      "blocks": {
        "question_JwPJDR": {
          "type": "question",
          "settings": {
            "title": "Where do you deliver?",
            "answer": "<p>We deliver free to every address in Australia. Stock is held in four SIHOO Australia warehouses – Sydney, Melbourne, Brisbane and Perth – so your order ships from the one nearest you, usually the next business day.</p>"
          }
        },
        "question_iPiNdX": {
          "type": "question",
          "settings": {
            "title": "How long does delivery take?",
            "answer": "<p>Orders are dispatched the next business day from the SIHOO Australia warehouse nearest you and usually arrive within 1–3 business days. Regional and remote addresses can take a little longer. You receive tracking by email and SMS as soon as the courier collects your order.</p>"
          }
        },
        "question_646tKV": {
          "type": "question",
          "settings": {
            "title": "How much does shipping cost?",
            "answer": "<p>Delivery is free Australia-wide on every chair, with no minimum order and no surcharge for regional or remote postcodes.</p>"
          }
        },
        "question_warehouses": {
          "type": "question",
          "settings": {
            "title": "Where do you ship from?",
            "answer": "<p>From the SIHOO Australia warehouse closest to you: Sydney (NSW, ACT), Melbourne (VIC, TAS), Brisbane (QLD, northern NSW) or Perth (WA). South Australia and the Northern Territory are served from the nearest warehouse with stock. If your item is only available in another state we tell you on the product page before you order.</p>"
          }
        },
        "question_tracking": {
          "type": "question",
          "settings": {
            "title": "Can I track my order?",
            "answer": "<p>Yes. A tracking link is emailed and texted to you as soon as the courier scans your carton at the warehouse. You can also find the tracking number in your SIHOO Australia account under Orders.</p>"
          }
        },
        "question_damaged": {
          "type": "question",
          "settings": {
            "title": "What if my carton arrives damaged?",
            "answer": "<p>Photograph the carton before opening it and email the photos to <a href=\"mailto:support@sihoo.com.au\">support@sihoo.com.au</a> with your order number. Replacement parts are dispatched from the nearest warehouse, usually within two business days, at no cost to you.</p>"
          }
        }
      },
