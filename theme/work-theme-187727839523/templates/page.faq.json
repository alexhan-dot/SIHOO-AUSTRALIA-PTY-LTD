      "settings": {
        "title": "FAQ",
        "use_h1": true,
        "text": "<p>Welcome to the SIHOO Australia FAQ page! Here, we’ve compiled the most frequently asked questions about our products, services, and policies to help you find the information you need. If you have further questions, feel free to contact us anytime.</p>",
        "show_search": true,
