    "faq-content-1": {
      "type": "collapsible-tabs",
      "blocks": {
        "question-1": {
          "type": "question",
          "settings": {
            "title": "Who is SIHOO?",
            "answer": "<p>SIHOO is a leading brand specialising in ergonomic office furniture. We focus on designing and manufacturing high-quality office chairs and standing desks that support healthy posture and long-term comfort, helping people work more productively.</p>"
          }
        },
        "question-2": {
          "type": "question",
          "settings": {
            "title": "Where is SIHOO based?",
            "answer": "<p>SIHOO is a global company with its products available across various markets, including Australia. Our Australian headquarters is located at 11 Ferndell Street, South Granville, NSW 2142.</p>"
          }
        },
        "question_NNpVBP": {
          "type": "question",
          "settings": {
            "title": "What products does SIHOO offer?",
            "answer": "<p>SIHOO offers a range of ergonomic office chairs, standing desks, and office furniture accessories. Our ergonomic chairs are designed with adjustable features, such as lumbar support, armrests, breathable mesh backs, and recline functions, tailored for both home and office use.</p>"
          }
        },
        "question_BpxQGN": {
          "type": "question",
          "settings": {
            "title": "What sets SIHOO apart from other brands?",
            "answer": "<p>SIHOO stands out with its dedication to ergonomics, innovation, and durability. Our chairs are certified by international standards, and we focus on creating products that prioritise user comfort and health. SIHOO chairs are ideal for extended periods of sitting, whether for work, study, or gaming.</p>"
          }
        }
      },
      "block_order": [
        "question-1",
        "question-2",
        "question_NNpVBP",
        "question_BpxQGN"
      ],
      "settings": {
        "title": "1. What is SIHOO?"
      }
    },
    "faq-content-2": {
      "type": "collapsible-tabs",
      "blocks": {
        "question-1": {
          "type": "question",
          "settings": {
            "title": "What makes a SIHOO chair ergonomic?",
            "answer": "<p>SIHOO chairs are designed to promote good posture by offering features such as adjustable lumbar support, seat height, recline angles, and adjustable armrests. These features ensure that the chair adapts to the user’s body, providing personalised comfort and reducing strain on the back, neck, and shoulders.</p>"
          }
        },
        "question-2": {
          "type": "question",
          "settings": {
            "title": "Can an ergonomic chair really help with back pain?",
            "answer": "<p>Yes, SIHOO ergonomic chairs are specifically designed to provide proper support to the spine, encouraging good posture and reducing back pain. The lumbar support helps maintain the natural curve of the spine, while adjustable features allow you to sit comfortably for long periods.</p>"
          }
        },
        "question_7aFgLr": {
          "type": "question",
          "settings": {
            "title": "Are SIHOO chairs good for gaming?",
            "answer": "<p>Absolutely! Our chairs, like the M57 and M18 models, are popular among gamers because of their comfort and customisable features. The adjustable recline and lumbar support help reduce fatigue during long gaming sessions, making them a great choice for gamers.</p>"
          }
        }
      },
      "block_order": [
        "question-1",
        "question-2",
        "question_7aFgLr"
      ],
      "settings": {
        "title": "2. Why Choose a SIHOO Ergonomic Chair?"
      }
    },
    "collapsible_tabs_wjV8tm": {
      "type": "collapsible-tabs",
      "blocks": {
        "question_8Q6Hhz": {
          "type": "question",
          "settings": {
            "title": "How do I adjust the seat height?",
            "answer": "<p>To adjust the seat height, use the lever under the seat. Raise or lower the seat so that your feet are flat on the floor and your knees are at a 90-degree angle. This position helps reduce pressure on your thighs and improves circulation.</p>"
          }
        },
        "question_hH4maP": {
          "type": "question",
          "settings": {
            "title": "How do I adjust the lumbar support?",
            "answer": "<p>SIHOO chairs feature dual-adjustable lumbar support. You can move the support vertically and horizontally to match the natural curve of your spine, providing continuous lower back comfort. Adjust the lumbar support until it fits snugly against your lower back.</p>"
          }
        },
        "question_3eUC8X": {
          "type": "question",
          "settings": {
            "title": "What is the best recline angle for working?",
            "answer": "<p>SIHOO chairs offer recline angles up to 126°. For work, a slight recline of 90° to 110° is recommended as it helps you stay focused while maintaining good posture. For relaxation or breaks, a deeper recline can help relieve tension.</p>"
          }
        }
      },
      "block_order": [
        "question_8Q6Hhz",
        "question_hH4maP",
        "question_3eUC8X"
      ],
      "settings": {
        "title": "3. How to Adjust a SIHOO Chair"
      }
    },
    "collapsible_tabs_DAwCYY": {
      "type": "collapsible-tabs",
      "blocks": {
        "question_JwPJDR": {
          "type": "question",
          "settings": {
            "title": "Where do you deliver?",
            "answer": "<p>We deliver free to every address in Australia. Stock is held in four SIHOO Australia warehouses – Sydney, Melbourne, Brisbane and Perth – so your order ships from the one nearest you.</p>"
          }
        },
        "question_iPiNdX": {
          "type": "question",
          "settings": {
            "title": "How long does delivery take?",
            "answer": "<p>Most orders are dispatched the same or next business day and arrive within 1–5 business days: metro Sydney, Melbourne, Brisbane and Perth usually 1–3 business days, other capitals and regional centres 2–5, remote addresses 5–10. You receive tracking by email and SMS as soon as the courier collects your order.</p>"
          }
        },
        "question_646tKV": {
          "type": "question",
          "settings": {
            "title": "How much does shipping cost?",
            "answer": "<p>Delivery is free Australia-wide on every chair, with no minimum order and no surcharge for regional or remote postcodes.</p>"
          }
        },
        "question_warehouses": {
          "type": "question",
          "settings": {
            "title": "Where do you ship from?",
            "answer": "<p>From the SIHOO Australia warehouse closest to you: Sydney (NSW, ACT), Melbourne (VIC, TAS), Brisbane (QLD, northern NSW) or Perth (WA). South Australia and the Northern Territory are served from the nearest warehouse with stock. If your item is only available in another state we tell you on the product page before you order.</p>"
          }
        }
      },
      "block_order": [
