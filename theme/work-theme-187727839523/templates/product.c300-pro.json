          }
        },
        "text_R4je3R": {
          "type": "text",
          "settings": {
            "text": "<p>When you move your upper body around or reach down to the side to pick up a pen you drop, the streamlined backrest with triangular frame flexes and matches your back, providing continuous support.</p>",
