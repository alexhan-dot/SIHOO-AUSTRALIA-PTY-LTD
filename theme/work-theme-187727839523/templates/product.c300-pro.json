    "image_with_text_cgmn3V": {
      "type": "image-with-text",
      "blocks": {
        "heading_wrwT34": {
          "type": "heading",
          "settings": {
            "title": "Adaptive Anti-Spine Lumbar Support",
            "use_h1": false
          }
        },
        "text_JMmVtJ": {
          "type": "text",
          "settings": {
            "text": "<p>Thanks to the BM (Body Movement) Tracking System, the integrated lumbar support automatically conforms to your spine’s natural curvature—delivering continuous, posture-perfect comfort across every seating position without any manual adjustments.</p>",
            "enlarge_text": false
          }
        }
      },
