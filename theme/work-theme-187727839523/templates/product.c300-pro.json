    "image_with_text_emAkdX": {
      "type": "image-with-text",
      "blocks": {
        "heading_Ezenpy": {
          "type": "heading",
          "settings": {
            "title": "Adjustable Seat Depth for Custom Comfort",
            "use_h1": false
          }
        },
        "text_zTWjfW": {
          "type": "text",
          "settings": {
            "text": "<p>The DORO C300 Pro features an expanded seat cushion that creates a more generous seating area, ideal for users of all body types. Its one-touch depth-adjustment lever lets you slide the seat forward or back—ensuring your thighs are fully supported and your posture is precisely aligned for hours of fatigue-free comfort.<br/><br/></p>",
            "enlarge_text": false
          }
        }
      },
