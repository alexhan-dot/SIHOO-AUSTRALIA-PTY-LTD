    "image_with_text_7cGCc4": {
      "type": "image-with-text",
      "blocks": {
        "heading_ib8aLt": {
          "type": "heading",
          "disabled": true,
          "settings": {
            "title": "Keep Your Arms Supported in Three Directions with Adjustable Armrests",
            "use_h1": false
          }
        },
        "text_6DMTGX": {
          "type": "text",
          "settings": {
            "text": "<h3>Keep Your Arms Supported in Three Directions with Adjustable Armrests</h3><p>The Sihoo M57 comes with 3D adjustable armrests that move up, down, forward, and rotate. These 3D adjustable options provide support for your arms and shoulders, reducing fatigue and enhancing ergonomics. This feature makes the chair versatile for typing, reading, or even playing mobile games.</p>",
            "enlarge_text": false
          }
        }
