    "rich_text_tiLGxg": {
      "type": "rich-text",
      "blocks": {
        "heading_VWaLer": {
          "type": "heading",
          "settings": {
            "title": "Sihoo M57 Ergonomic Office Chair - Stay Cool, Stay Comfortable",
            "use_h1": false
          }
        },
        "text_TXJ7kj": {
          "type": "text",
          "settings": {
            "text": "<p>The SIHOO M57 Ergonomic Office Chair features a breathable full-mesh backrest and seat that promote continuous airflow, helping you stay cool and comfortable during long hours of sitting. Its durable, high-quality mesh resists wear and provides responsive support without trapping heat or moisture, making it ideal for warmer environments. With adjustable ergonomic features and reliable everyday support, the SIHOO M57 is a popular choice for home offices and professional workspaces. Available from $329.</p>",
            "enlarge_text": false
          }
        }
      },
      "block_order": [
        "heading_VWaLer",
        "text_TXJ7kj"
      ],
