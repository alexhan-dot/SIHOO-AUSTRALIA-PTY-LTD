    "image_with_text_mpNwQN": {
      "type": "image-with-text",
      "blocks": {
        "heading_zrrim6": {
          "type": "heading",
          "disabled": true,
          "settings": {
            "title": "Recline with Ease, Relax in Comfort with an Ergonomic Office Chair",
            "use_h1": false
          }
        },
        "text_FXrigT": {
          "type": "text",
          "settings": {
            "text": "<h3>Recline with Ease, Relax in Comfort with an Ergonomic Office Chair</h3><p>Take a break and lean back in the Sihoo M57, which offers a generous recline angle of up to 126°. The smooth tilt mechanism and adjustable seat height let you customise the chair for different office applications. Versions with footrest included even turn this into an ergonomic office chair with footrest, perfect for relaxing between tasks.</p>",
            "enlarge_text": false
          }
        }
      },
      "block_order": [
        "heading_zrrim6",
        "text_FXrigT"
      ],
      "settings": {
        "image": "shopify://shop_images/02_6d56920e-1abf-4725-ab84-b9a285e422bb.jpg",
        "image_width": 700,
        "image_link": "",
        "image_position": "right",
        "text_alignment": "left",
        "color_scheme": "default",
