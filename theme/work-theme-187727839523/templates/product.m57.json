    "image_with_text_xNyWdM": {
      "type": "image-with-text",
      "blocks": {
        "heading_mhBYtH": {
          "type": "heading",
          "disabled": true,
          "settings": {
            "title": "The Seat Back Contoured to Your Back for Better Ergonomics",
            "use_h1": false
          }
        },
        "text_BPCQin": {
          "type": "text",
          "settings": {
            "text": "<h3>The Seat Back Contoured to Your Back for Better Ergonomics</h3><p>Crafted to support your entire back from top to bottom, the Sihoo M57 office chair's backrest and the seat are sleek and streamlined. The design contours naturally to the natural curve of your spine, helping you maintain a healthy 'S' shape. This level of comfort and support makes the M57 ideal for home office professionals, creative tasks, or even gaming.</p>",
            "enlarge_text": false
          }
        }
      },
      "block_order": [
        "heading_mhBYtH",
        "text_BPCQin"
      ],
      "settings": {
        "image": "shopify://shop_images/01_14737d3c-de55-4795-b202-43c9a2a30376.jpg",
