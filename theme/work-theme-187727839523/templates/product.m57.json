      }
    },
    "image_with_text_wWpbfD": {
      "type": "image-with-text",
      "blocks": {
        "heading_8VEXjN": {
          "type": "heading",
          "disabled": true,
          "settings": {
            "title": "Adjustable Lumbar Support for Personalised Back Comfort",
            "use_h1": false
          }
        },
        "text_MiTJxq": {
          "type": "text",
          "settings": {
            "text": "<h3>Adjustable Lumbar Support for Personalised Back Comfort</h3><p>The dual lumbar support adjusts both vertically and horizontally, making it easy to fit your lower back and provide tailored relief. Because the lumbar support adjusts, you stay supported no matter how you move. This feature keeps your posture balanced and your spine aligned, essential for long hours of work.</p>",
            "enlarge_text": false
          }
        }
      },
      "block_order": [
        "heading_8VEXjN",
        "text_MiTJxq"
      ],
      "settings": {
