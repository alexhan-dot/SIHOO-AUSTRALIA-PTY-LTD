    "image_with_text_EbGTGg": {
      "type": "image-with-text",
      "blocks": {
        "heading_egLCx7": {
          "type": "heading",
          "disabled": true,
          "settings": {
            "title": "Headrest to Keep Your Head Supported and Aligned",
            "use_h1": false
          }
        },
        "text_RznRHJ": {
          "type": "text",
          "settings": {
            "text": "<h3>Headrest to Keep Your Head Supported and Aligned</h3><p>The adjustable headrest moves up to 8 cm and rotates 45 degrees, fitting the natural curve of your neck. It relieves strain and supports alignment whether upright or reclining. This detail ensures the Sihoo M57 ergonomic chair keeps you comfortable throughout the day, supporting both focus and relaxation.</p>",
            "enlarge_text": false
          }
        }
      },
