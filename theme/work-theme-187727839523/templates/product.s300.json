    "image_with_text_emAkdX": {
      "type": "image-with-text",
      "blocks": {
        "heading_Ezenpy": {
          "type": "heading",
          "disabled": true,
          "settings": {
            "title": "Anti-Gravity Recline for Smooth Ergonomic Support",
            "use_h1": false
          }
        },
        "text_zTWjfW": {
          "type": "text",
          "settings": {
            "text": "<h3>Anti-Gravity Recline for Smooth Ergonomic Support</h3><p><br/>The anti-gravity reclining mechanism helps create smoother movement and weight distribution while reclining, supporting comfort during long sitting sessions and reducing pressure on the body.<br/><br/></p>",
