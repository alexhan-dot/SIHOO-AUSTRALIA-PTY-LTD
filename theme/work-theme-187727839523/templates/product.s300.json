    "image_with_text_cgmn3V": {
      "type": "image-with-text",
      "blocks": {
        "heading_wrwT34": {
          "type": "heading",
          "disabled": true,
          "settings": {
            "title": "Experience Weightlessness with the Doro S300",
            "use_h1": false
          }
        },
        "text_JMmVtJ": {
          "type": "text",
          "settings": {
            "text": "<h3>Experience Weightlessness with the Doro S300</h3><p>Featuring elastic plates made from aerospace-grade glass fibre, the <strong>Sihoo Doro S300</strong> provides personalised tension adjustment to accommodate individuals of all sizes and weights. Enjoy effortless reclining at any angle without the need to lock the backrest, and smoothly return to an upright position with ease.</p>",
            "enlarge_text": false
          }
        }
      },
      "block_order": [
        "heading_wrwT34",
        "text_JMmVtJ"
      ],
      "settings": {
        "image": "shopify://shop_images/S300_03_1358_840.gif",
        "image_width": 700,
        "image_link": "",
        "image_position": "right",
        "text_alignment": "left",
        "color_scheme": "default",
        "background_color": ""
      }
    },
    "image_with_text_exBAbL": {
      "type": "image-with-text",
      "blocks": {
        "heading_BcqGEn": {
          "type": "heading",
          "disabled": true,
          "settings": {
            "title": "Comprehensive lower back support",
            "use_h1": false
          }
        },
        "text_cM73X7": {
          "type": "text",
          "settings": {
            "text": "<h3>Comprehensive lower back support</h3><p>The <strong>dual dynamic lumbar support</strong>, shaped like wings, consists of two distinct pads to deliver adaptable and comprehensive lower back support. This feature accommodates a variety of body shapes and sitting positions. Additionally, the gas lift allows for precise lumbar adjustment between 90° and 105°, ensuring a perfect fit for every user.</p>",
            "enlarge_text": false
          }
        }
      },
      "block_order": [
        "heading_BcqGEn",
        "text_cM73X7"
      ],
      "disabled": true,
      "settings": {
        "image": "shopify://shop_images/01_8978772d-779b-4bfc-9a80-cdad91a683a0.gif",
