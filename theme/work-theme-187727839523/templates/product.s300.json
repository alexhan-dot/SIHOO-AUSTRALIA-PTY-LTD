    "image_with_text_UiDj6e": {
      "type": "image-with-text",
      "blocks": {
        "heading_GmmkxF": {
          "type": "heading",
          "disabled": true,
          "settings": {
            "title": "Comfort for the Entire Back",
            "use_h1": false
          }
        },
        "text_EM8cPi": {
          "type": "text",
          "settings": {
            "text": "<h3>Comfort for the Entire Back</h3><p>The upper section of the backrest can be independently adjusted into five positions, providing proper support for your shoulders and neck, whether you're 150 cm (5 feet) or 190 cm (6 feet 3 inches) tall. At the same time, the lumbar support remains perfectly positioned to offer effective lower back support.</p>",
            "enlarge_text": false
          }
        }
      },
      "block_order": [
        "heading_GmmkxF",
        "text_EM8cPi"
      ],
      "settings": {
        "image": "shopify://shop_images/1940-1200_1_fa5d8119-df20-41b5-a4ff-e955431b8052.jpg",
