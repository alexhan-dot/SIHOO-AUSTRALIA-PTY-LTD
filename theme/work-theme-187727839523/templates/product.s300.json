    "rich_text_JeXmGt": {
      "type": "rich-text",
      "blocks": {
        "heading_MbQCKR": {
          "type": "heading",
          "settings": {
            "title": "Premium Ergonomic Office Chair for Long Work Hours",
            "use_h1": false
          }
        },
        "text_NGw3q4": {
          "type": "text",
          "settings": {
            "text": "<p>The SIHOO DORO-S300 <a href=\"https://sihoo.com.au/\" title=\"https://sihoo.com.au/\">ergonomic office chair</a> is designed for users who spend long hours sitting at a desk, working from home, gaming, or managing professional office tasks. With advanced ergonomic support features, breathable mesh materials, adjustable lumbar support, and an anti-gravity reclining mechanism that adjusts to your weight automatically, the DORO-S300 is built to support posture, comfort, and productivity throughout the day.</p><p>Whether you need ergonomic support for a home office or a premium office chair for daily work, the SIHOO DORO-S300 combines ergonomic technology with modern comfort for long-term sitting support.</p>",
            "enlarge_text": false
          }
        }
      },
      "block_order": [
        "heading_MbQCKR",
        "text_NGw3q4"
      ],
