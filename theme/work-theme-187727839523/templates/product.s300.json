    },
    "image_with_text_D4TiKX": {
      "type": "image-with-text",
      "blocks": {
        "heading_mEUwWD": {
          "type": "heading",
          "disabled": true,
          "settings": {
            "title": "Coordinated Support for the Full Body",
            "use_h1": false
          }
        },
        "text_R4je3R": {
          "type": "text",
          "settings": {
            "text": "<h3>Coordinated Support for the Full Body</h3><p>The dual dynamic lumbar support, designed like wings, includes two pads that offer flexible lower back support, adapting to different body types and sitting positions. The gas lift enables precise adjustment of the lumbar support between 90° and 105°, ensuring the perfect fit for every user.</p>",
            "enlarge_text": false
          }
        }
      },
      "block_order": [
