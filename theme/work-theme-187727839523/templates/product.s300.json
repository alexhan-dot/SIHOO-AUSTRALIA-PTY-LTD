    "image_with_text_H8cx7F": {
      "type": "image-with-text",
      "blocks": {
        "heading_aDbrPk": {
          "type": "heading",
          "disabled": true,
          "settings": {
            "title": "Soft and Spacious Headrest",
            "use_h1": false
          }
        },
        "text_fFLU3g": {
          "type": "text",
          "settings": {
            "text": "<h3>Soft and Spacious Headrest</h3><p>Crafted from soft, touchable material, the headrest gently conforms to the curve of your neck, ensuring a perfect fit every time. With its generously sized surface area, you can rest your head comfortably on the side, whether you're relaxing after a long day or taking a short break from your tasks.</p>",
            "enlarge_text": false
          }
        }
      },
