    "image_with_text_NTA6Lj": {
      "type": "image-with-text",
      "blocks": {
        "heading_iEY6gz": {
          "type": "heading",
          "disabled": true,
          "settings": {
            "title": "Cloud-Like Softness",
            "use_h1": false
          }
        },
        "text_7jFwg6": {
          "type": "text",
          "settings": {
            "text": "<h3>Cloud-Like Softness</h3><p>The <strong>Sihoo Doro S300</strong> uses a unique weaving technique that combines Italian velvet with DuPont TPEE for its mesh material. This blend provides exceptional elasticity, durability, pressure relief, and a luxuriously soft texture.</p>",
