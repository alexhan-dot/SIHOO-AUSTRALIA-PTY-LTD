          "type": "heading",
          "settings": {
            "title": "Why Choose the SIHOO M18 Ergonomic Office Chair?",
            "use_h1": false
          }
        },
        "text_nCNiGQ": {
          "type": "text",
          "settings": {
            "text": "<p>• Adjustable lumbar support for ergonomic comfort during long work hours  <br/>• Breathable mesh materials designed for airflow and daily sitting comfort  <br/>• Reclining backrest with tilt adjustment for flexible seating positions  <br/>• Adjustable headrest and armrests for ergonomic support  <br/>• W-shaped seat cushion designed for sitting comfort and pressure distribution  <br/>• Durable steel frame and aluminium base for long-term reliability<br/><br/></p>",
            "enlarge_text": false
          }
        },
