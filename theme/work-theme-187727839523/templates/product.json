        "faq_item_3c9JPG": {
          "type": "faq_item",
          "settings": {
            "question": "Is the SIHOO M18 good for home offices?",
            "answer": "<p>The SIHOO M18 ergonomic chair is suitable for home office setups, study environments, and professional workspaces where ergonomic comfort and posture support are important during daily work.</p>"
          }
        },
        "faq_item_LRyztT": {
          "type": "faq_item",
          "settings": {
            "question": "Does the SIHOO M18 have adjustable lumbar support?",
            "answer": "<p>Yes. The SIHOO M18 ergonomic office chair includes adjustable lumbar support designed to help improve sitting comfort and reduce lower back pressure during long work sessions.</p>"
          }
        },
        "faq_item_Lfz4AP": {
          "type": "faq_item",
          "settings": {
            "question": "Are the armrests adjustable on the SIHOO M18?",
