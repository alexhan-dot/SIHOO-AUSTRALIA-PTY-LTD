            "bg_color": "#e3e3e3",
            "bg_gradient": "",
            "text_color": "#505050",
            "heading": "",
            "text": "<h3>Adjustable Armrest Support for Better Ergonomics</h3><p>The SIHOO M18 ergonomic office chair includes adjustable armrests designed to support natural arm positioning and improve comfort during work, study, and daily computer use.</p>",
            "show_segments": true,
