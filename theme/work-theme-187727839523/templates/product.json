            "show_icon": false,
            "icon": "star"
          }
        },
        "feature_RrGHxE": {
          "type": "feature",
          "settings": {
            "image": "shopify://shop_images/04_00293721-9a45-4528-b1b7-ebd026a090ef.jpg",
            "bg_color": "#e3e3e3",
            "bg_gradient": "",
            "text_color": "#505050",
            "heading": "",
            "text": "<h3>Adjustable Headrest Support for Neck Comfort</h3><p>The adjustable headrest is designed to support the neck and upper back during long sitting hours while helping improve ergonomic comfort across different sitting positions.</p>",
            "show_segments": true,
            "segments": 5,
            "active_segment": "4",
            "fill_segments": true,
            "show_labels": true,
            "label_left": "",
            "label_middle": "",
