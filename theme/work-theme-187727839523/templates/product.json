    "key_features_dyBe6t": {
      "type": "key-features",
      "blocks": {
        "feature_LhL9jp": {
          "type": "feature",
          "settings": {
            "image": "shopify://shop_images/3_ab94ab6f-7738-44ae-81b7-a6bae5ba2c47.webp",
            "bg_color": "#e3e3e3",
            "bg_gradient": "",
            "text_color": "#505050",
            "heading": "",
            "text": "<h3>Durable Steel Support Structure for Long-Term Reliability</h3><p>The SIHOO M18 ergonomic office chair is built with a durable steel support structure designed for stability, strength, and long-term daily use in home offices and professional workspaces.<br/><br/></p>",
            "show_segments": true,
            "segments": 5,
            "active_segment": "4",
            "fill_segments": true,
            "show_labels": true,
            "label_left": "",
            "label_middle": "",
            "label_right": "",
            "show_icon": false,
            "icon": "star"
          }
        },
        "feature_KtWiwp": {
          "type": "feature",
          "settings": {
            "image": "shopify://shop_images/4_2f6c4792-3622-452e-8f5d-55d06ac46377.jpg",
            "bg_color": "#c3c3c3",
            "bg_gradient": "",
            "text_color": "#505050",
            "heading": "",
            "text": "<h3>Durable Aluminium Chair Base for Everyday Use</h3><p>The aluminium chair base provides stable support and smooth mobility while maintaining a clean modern ergonomic office chair design suitable for daily work environments.</p>",
            "show_segments": true,
            "segments": 5,
            "active_segment": "2",
            "fill_segments": true,
            "show_labels": true,
            "label_left": "",
            "label_middle": "",
            "label_right": "",
            "show_icon": false,
            "icon": "star"
          }
        },
        "feature_mzV8nf": {
          "type": "feature",
          "settings": {
            "image": "shopify://shop_images/photobank_7.jpg",
            "bg_color": "#e3e3e3",
            "bg_gradient": "",
            "text_color": "#505050",
            "heading": "",
            "text": "<h3>Reclining Comfort for Daily Breaks and Relaxation</h3><p>The reclining system allows users to adjust sitting positions throughout the day, helping improve comfort during work, relaxation, and short break periods.</p>",
            "show_segments": true,
            "segments": 5,
            "active_segment": "3",
            "fill_segments": true,
            "show_labels": true,
            "label_left": "",
            "label_middle": "",
            "label_right": "",
            "show_icon": false,
            "icon": "star"
          }
        },
        "feature_jTmtYU": {
          "type": "feature",
          "settings": {
            "image": "shopify://shop_images/C300-lumbar_support_15e7795a-ed45-4b9c-88cd-264a12448571.webp",
            "bg_color": "#e3e3e3",
            "bg_gradient": "",
            "text_color": "#505050",
            "heading": "",
            "text": "<h3>Ergonomic Lumbar Support for Daily Comfort</h3><p>The SIHOO M18 ergonomic office chair includes adjustable lumbar support designed to help reduce lower back pressure during long sitting sessions. Its ergonomic support system helps improve posture and daily comfort for home offices and professional workspaces.</p>",
            "show_segments": true,
            "segments": 5,
            "active_segment": "4",
            "fill_segments": true,
            "show_labels": true,
            "label_left": "",
            "label_middle": "",
            "label_right": "",
            "show_icon": false,
            "icon": "star"
          }
        },
        "feature_6Qj7aP": {
          "type": "feature",
          "settings": {
            "image": "shopify://shop_images/M18-10.jpg",
            "bg_color": "#e3e3e3",
            "bg_gradient": "",
            "text_color": "#505050",
            "heading": "",
            "text": "<h3>Breathable Mesh Comfort for Long Work Hours</h3><p>The breathable mesh materials used in the SIHOO M18 ergonomic chair help improve airflow and sitting comfort during long work sessions and warmer Australian conditions.</p>",
            "show_segments": true,
            "segments": 5,
            "active_segment": "4",
            "fill_segments": true,
            "show_labels": true,
            "label_left": "",
            "label_middle": "",
            "label_right": "",
            "show_icon": false,
            "icon": "star"
          }
        },
        "feature_deaXzE": {
          "type": "feature",
          "settings": {
            "image": "shopify://shop_images/7_97d170d1-a214-40f3-8231-843fd6b44178.jpg",
            "bg_color": "#e3e3e3",
            "bg_gradient": "",
            "text_color": "#505050",
            "heading": "",
            "text": "<h3>Adjustable Reclining Positions for Flexible Sitting Support</h3><p>The SIHOO M18 ergonomic office chair includes flexible reclining positions designed to support different sitting preferences throughout the day, from focused work sessions to short reclining breaks.</p>",
            "show_segments": true,
            "segments": 5,
            "active_segment": "4",
            "fill_segments": true,
            "show_labels": true,
            "label_left": "",
            "label_middle": "",
