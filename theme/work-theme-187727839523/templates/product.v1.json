    "faq_Mf8LwQ": {
      "type": "faq",
      "blocks": {
        "faq_item_7xGDKm": {
          "type": "faq_item",
          "settings": {
            "question": "What's the difference between the M18 and M18 Pro?",
            "answer": "<p>Hours at your desk. Under four hours a day, the base M18's 2D armrests and dual lumbar support are enough. Six hours or more, the M18 Pro's 4D linked armrests and self-weight sensing recline are worth the extra $90.</p>"
          }
        },
        "faq_item_3c9JPG": {
          "type": "faq_item",
          "settings": {
            "question": "Is the SIHOO M18 good for home offices?",
            "answer": "<p>The SIHOO M18 ergonomic chair is suitable for home office setups, study environments, and professional workspaces where ergonomic comfort and posture support are important during daily work.</p>"
          }
        },
        "faq_item_LRyztT": {
          "type": "faq_item",
          "settings": {
            "question": "Does the M18 come with a footrest?",
            "answer": "<p>Yes. The Black with Leg Rest variant adds a fold-out footrest.</p>"
          }
        },
        "faq_item_Lfz4AP": {
          "type": "faq_item",
          "settings": {
            "question": "Are the armrests adjustable on the SIHOO M18?",
            "answer": "<p>Yes. The SIHOO M18 includes adjustable armrests that help support different sitting positions and workspace setups.</p>"
          }
        },
        "faq_item_ymbhre": {
          "type": "faq_item",
          "settings": {
            "question": "Is the SIHOO M18 breathable for Australian weather?",
            "answer": "<p>The SIHOO M18 uses breathable mesh materials designed to improve airflow and comfort during long sitting hours and warmer Australian conditions.</p>"
          }
        },
        "faq_item_4zfVMB": {
          "type": "faq_item",
          "settings": {
            "question": "What are the M18's seat dimensions?",
            "answer": "<p>Seat height 46 to 55cm, seat width 51cm, seat depth 46cm. Overall chair height is 107 to 130cm.</p>"
          }
        },
        "faq_item_kTUF3z": {
          "type": "faq_item",
          "settings": {
            "question": "What's the maximum weight the M18 supports?",
            "answer": "<p>136kg (300lb), suited to users from 150cm to 190cm tall.</p>"
          }
        }
      },
