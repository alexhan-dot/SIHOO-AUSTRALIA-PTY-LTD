    "custom_multi_column_cLXpJq": {
      "type": "custom-multi-column",
      "blocks": {
        "column_ApwJFk": {
          "type": "column",
          "settings": {
            "hide_image": true,
            "title": "",
            "description": "<h3>Overview</h3><p>The SIHOO Doro C300 Pro combines adaptive ergonomic support, breathable comfort and flexible adjustability for long hours of work, study or gaming. Its Multi-Point Ergonomic Support System, adaptive lumbar support and linked recline move naturally with your body to support better posture and reduce fatigue.</p><p><strong>Product Name:</strong></p><p>SIHOO Doro C300 Ergonomic Office Chair<br/><strong>Support System:</strong> Multi-Point Ergonomic Support<br/><strong>Materials:</strong> High-elastic wave mesh that is breathable, oil resistant and stain resistant<br/><strong>Assembly:</strong> Simple assembly required</p><p><strong>Product Weight:</strong> 25.1 kg<br/><strong>Net Weight:</strong> 24.2 kg<br/><strong>Maximum Load:</strong> 150 kg<br/><strong>Recommended User Height:</strong> 150–190 cm</p><p></p><p><strong>General Dimensions:</strong></p><p>71 cm W × 71 cm D × 114–130 cm H</p><p><strong>Chair Back Lifting Height:</strong> 113.6–129.3 cm<br/><strong>Seat Height:</strong> 44–54 cm<br/><strong>Seat Depth:</strong> 42.7–45.1 cm<br/><strong>Seat Width:</strong> 51 cm<br/><strong>Maximum Hip Width:</strong> 51.5 cm</p>",
            "note": ""
          }
        },
        "column_4FUVgY": {
          "type": "column",
          "settings": {
            "hide_image": false,
            "image": "shopify://shop_images/C300_b84f4cd6-6558-4d28-945d-9c48ff990388.webp",
            "title": "",
            "description": "<p><strong>Headrest:</strong> Wide adjustable 3D headrest with 5 cm height adjustment, 2.5 cm forward and backward movement, 35° headrest rotation and 45° bracket rotation<br/><strong>Mechanism:</strong> Self-weighting chassis with three-position recline lock<br/><strong>Backrest:</strong> Flexible breathable mesh backrest<br/><strong>Lumbar Support:</strong> Adaptive PA+ fibre lumbar support<br/><strong>Suspension System:</strong> Multi-Point Ergonomic Support<br/></p>",
            "note": ""
          }
        },
        "column_WNKPgR": {
          "type": "column",
          "settings": {
            "hide_image": false,
            "image": "shopify://shop_images/C300_e1e9ffaa-5125-4e43-a893-9fd5c7fcad6f.webp",
            "title": "",
            "description": "<p><strong>Armrests:</strong> 6D adjustable PU armrests with height, angle, forward, backward and rotational adjustments</p><p><strong>Seat:</strong> Waterfall Mesh Seat with up to 4 cm seat-depth adjustment<br/><strong>Linked Recline:</strong> Seat, backrest and armrests move together while reclining<br/><strong>Recline Angles:</strong> 105°, 120° and 135°<br/><strong>Gas Lift:</strong> SGS Class 4 gas lift</p>",
            "note": ""
          }
        }
      },
