    "collapsible_tabs_AWRURX": {
      "type": "collapsible-tabs",
      "blocks": {
        "question_7XRT9a": {
          "type": "question",
          "settings": {
            "title": "1. What makes the Sihoo Doro C500 different from other office chairs sold in Australia?",
            "answer": "<p>The C500 stands out with its advanced ergonomic features, such as a 6D adjustable armrest, adaptive lumbar support, and aerospace-grade glass fibre construction. Designed for Australian workplaces, it offers superior comfort and durability—making it a popular choice among professionals who value both style and function.</p>"
          }
        },
        "question_GLJV8c": {
          "type": "question",
          "settings": {
            "title": "2. Is the Sihoo Doro C500 suitable for long hours of sitting?",
            "answer": "<p>Absolutely. The C500’s breathable mesh back, adjustable seat depth, and waterfall-edge cushion ensure all-day comfort and support, helping you stay focused and productive during extended work sessions.</p>"
          }
        },
        "question_UJEmwc": {
          "type": "question",
          "settings": {
            "title": "3. Does the Sihoo Doro C500 come with a warranty?",
            "answer": "<p>Yes, every C500 chair is backed by a comprehensive 5-year warranty. You can buy with confidence knowing your chair is built to last and supported by local after-sales service in Australia.</p>"
          }
        },
        "question_FXcjwN": {
          "type": "question",
          "settings": {
            "title": "4. How does the C500 support good posture and prevent back pain?",
            "answer": "<p>The C500 features an adaptive anti-spine lumbar support and customisable seat adjustments that encourage natural alignment and reduce the risk of back and neck strain—essential for healthy posture during long hours at the desk.</p>"
          }
        },
        "question_K6wfdN": {
          "type": "question",
          "settings": {
            "title": "5. Can I adjust the armrests, seat, and backrest to fit my body?",
            "answer": "<p>Definitely. The C500 offers 6D armrests, a 4cm adjustable seat depth, 6cm backrest height adjustment, and a wide-angle 3D headrest. This level of adjustability makes it easy to find your ideal sitting position, regardless of your height or body type.</p>"
          }
        },
        "question_BkkfGe": {
          "type": "question",
          "settings": {
            "title": "6. Is the Sihoo Doro C500 easy to assemble?",
            "answer": "<p>Yes, the C500 comes with clear instructions and all tools included. Most users can fully assemble the chair in under 20 minutes—no professional help required.</p>"
          }
        },
        "question_d8y7h6": {
          "type": "question",
          "settings": {
            "title": "7. Does the C500 mesh fabric get hot or uncomfortable in the Australian climate?",
            "answer": "<p>Not at all. The C500 uses premium, cloud-like mesh that promotes airflow, keeping you cool and comfortable—even during hot Australian summers.</p>"
          }
        },
        "question_aEMANk": {
          "type": "question",
          "settings": {
            "title": "8. Is the Sihoo Doro C500 suitable for both home offices and corporate environments?",
            "answer": "<p>Absolutely. Its modern executive design, robust aluminium alloy base, and certified safety make it a top choice for both home offices and busy corporate settings across Australia.</p>"
          }
        },
        "question_qfwJF7": {
          "type": "question",
          "settings": {
            "title": "9. What certifications does the C500 hold, and why are they important?",
            "answer": "<p>The Sihoo Doro C500 is Level 4, BIFMA, and SGS certified. These international certifications guarantee the chair meets strict standards for safety, quality, and durability—giving you peace of mind with every purchase.</p>"
          }
        },
        "question_GGyWPJ": {
          "type": "question",
          "settings": {
            "title": "10. Why is the Sihoo Doro C500 a bestseller in Australia?",
            "answer": "<p>Australian customers love the C500 for its unmatched ergonomic support, stylish design, and proven durability. With glowing reviews and strong demand nationwide, it’s quickly become a favourite among those seeking a high-quality, adjustable office chair.</p>"
          }
        }
      },
