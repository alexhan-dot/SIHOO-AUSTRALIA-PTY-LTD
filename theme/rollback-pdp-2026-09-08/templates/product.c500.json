          "disabled": true,
          "settings": {
            "title": "Breakthrough Anti-Gravity Mechanism",
            "use_h1": false
          }
        },
        "text_zTWjfW": {
          "type": "text",
          "settings": {
            "text": "<h3>Breakthrough Anti-Gravity Mechanism</h3><p>The Sihoo Doro C500 features a groundbreaking Anti-Gravity Mechanism, incorporating elastic plates made from aerospace-grade glass fibre - the same material used in spacecraft. This innovative design offers unmatched flexibility and adaptability, allowing users to enjoy full-body support with a weightless reclining experience that seems to defy gravity.</p>",
            "enlarge_text": false
          }
        },
        "button_UyLx7m": {
          "type": "button",
          "disabled": true,
