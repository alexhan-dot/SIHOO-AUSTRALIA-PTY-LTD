    "image_with_text_D4TiKX": {
      "type": "image-with-text",
      "blocks": {
        "heading_mEUwWD": {
          "type": "heading",
          "disabled": true,
          "settings": {
            "title": "Experience Effortless Comfort with the Sihoo Doro C500",
            "use_h1": false
          }
        },
        "text_R4je3R": {
          "type": "text",
          "settings": {
            "text": "<h3>Experience Effortless Comfort with the Sihoo Doro C500</h3><p>The Sihoo Doro C500 offers personalised tension adjustment for users of all sizes and weights. Enjoy effortless reclining and return smoothly to an upright position with ease. Enhance your workspace with ergonomic design built for modern professionals, and discover why Sihoo ergonomic chairs deliver next-level comfort trusted by thousands.</p>",
            "enlarge_text": false
          }
        }
      },
