    "image_with_text_UiDj6e": {
      "type": "image-with-text",
      "blocks": {
        "heading_GmmkxF": {
          "type": "heading",
          "disabled": true,
          "settings": {
            "title": "Adjustable Backrest Height for Tailored Support",
            "use_h1": false
          }
        },
        "text_EM8cPi": {
          "type": "text",
          "settings": {
            "text": "<h3>Adjustable Backrest Height for Tailored Support</h3><p>The upper section of the backrest can be independently adjusted across five positions, offering a generous 6cm seat height adjustment range. This ensures proper support for your shoulders and neck, whether you're 150 cm (5 feet) or 190 cm (6 feet 3 inches) tall. Throughout every adjustment, the lumbar system of Sihoo ergonomic chairs remains perfectly aligned to provide effective lower back support.</p>",
            "enlarge_text": false
          }
        }
      },
      "block_order": [
