        "image_position": "right",
        "text_alignment": "left",
        "color_scheme": "default",
        "background_color": ""
      }
    },
    "image_with_text_exBAbL": {
      "type": "image-with-text",
      "blocks": {
        "heading_BcqGEn": {
          "type": "heading",
          "disabled": true,
          "settings": {
            "title": "Adaptive Anti-Spine Lumbar Support",
            "use_h1": false
          }
        },
        "text_cM73X7": {
          "type": "text",
          "settings": {
            "text": "<h3>Adaptive Anti-Spine Lumbar Support</h3><p>With the innovative Body Movement (BM) Tracking System, the integrated dynamic lumbar support of the Sihoo Doro C500 automatically adapts to the natural curve of your spine. This lasting ergonomic quality provides continuous posture-perfect alignment in any sitting position - no manual adjustments required.</p>",
            "enlarge_text": false
          }
        }
      },
      "block_order": [
        "heading_BcqGEn",
        "text_cM73X7"
      ],
      "settings": {
