      "type": "rich-text",
      "blocks": {
        "heading_fkW96k": {
          "type": "heading",
          "settings": {
            "title": "Award-winning design",
            "use_h1": false
          }
        },
        "text_VzndM3": {
          "type": "text",
          "settings": {
            "text": "<p>Sihoo Doro S300, a recipient of the esteemed German Design Award, boasts both comfort and visual allure. Crafted from a single piece of aluminum alloy, its main structure undergoes 13 meticulous procedures to achieve its stunning and elegant esthetics.</p>",
            "enlarge_text": true
          }
        }
