    "image_with_text_cgmn3V": {
      "type": "image-with-text",
      "blocks": {
        "heading_wrwT34": {
          "type": "heading",
          "disabled": true,
          "settings": {
            "title": "Experience Weightlessness with the Doro C500",
            "use_h1": false
          }
        },
        "text_JMmVtJ": {
          "type": "text",
          "settings": {
            "text": "<h3>Experience Weightlessness with the Doro C500</h3><p>Featuring elastic plates crafted from aerospace-grade glass fibre, the Sihoo Doro C500 offers personalised tension adjustment to suit users of all sizes and weights. These chairs are designed for next-level comfort, so you can stay supported and comfortable at any angle without locking the backrest. Return smoothly to an upright position and enjoy comfort even during long hours of gaming, working, or relaxing.</p>",
            "enlarge_text": false
          }
        }
      },
      "block_order": [
        "heading_wrwT34",
        "text_JMmVtJ"
      ],
      "settings": {
        "image": "shopify://shop_images/S300_03_1358_840.gif",
