          }
        },
        "accordion_qNiX34": {
          "type": "accordion",
          "settings": {
            "title": "Features",
            "icon": "",
            "content": "<p><strong>Dynamic Lumbar Support</strong><br/>The advanced lumbar support system automatically adjusts to your spine, providing continuous back comfort without any manual tweaking.</p><p><strong>Adaptive Design</strong><br/>Engineered to fit users from <strong>152 cm</strong> to <strong>191 cm</strong>, ensuring everyone enjoys optimal support.</p><p><strong>Spacious Cushion</strong><br/>A larger seat cushion enhances comfort and offers plenty of room, with an adjustable seat depth for a perfect personalised fit.</p><p><strong>4-Direction Adjustable<br/>Armrests</strong><br/>Armrests move in six directions up/down, forward/back, rotated inwards/outwards—giving you versatile arm positioning throughout long workdays.</p><p><strong>Easy Controls</strong><br/>Effortlessly adjust seat height and recline angle using a single, conveniently placed handle.</p><p><strong>Flexible Backrest</strong><br/>The streamlined backrest flexes with your movements, offering continuous support as you shift position.</p><p><strong>Precision Headrest Adjustment</strong><br/>Fine-tune headrest height, depth or rotation to achieve the ideal neck support and comfort.</p><p><strong>Sleek, Modern Design</strong><br/>With its contemporary aesthetic, the Sihoo DORO C100 complements any workspace—office, home or study.</p><p><strong>Breathable Mesh</strong><br/>Fully breathable mesh is elastic, soft and skin-friendly—durable, easy to clean and perfect for all-day comfort.</p>",
            "page": "",
            "custom_liquid": "",
            "open": false,
            "show_in_quickbuy": false
          }
        },
        "ff72739d-90fa-44b3-896f-ca72e4704c77": {
          "type": "accordion",
          "settings": {
            "title": "Benefits",
            "icon": "",
            "content": "<ul><li>Supports up to <strong>136 kg</strong></li><li>Dynamic lumbar support for all-day back comfort</li><li>Designed to suit users from <strong>152 cm</strong> to <strong>190 cm</strong> tall</li><li>Spacious seat cushion with adjustable depth</li><li>4D adjustable armrests for versatile support</li><li>Certified by BIFMA and SGS for quality and durability</li><li>Endorsed by The Gadgeteer, MMORPG, and loved by thousands of workers for ergonomic excellence</li></ul>",
            "page": "",
            "custom_liquid": "",
