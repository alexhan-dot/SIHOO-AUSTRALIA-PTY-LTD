          "type": "heading",
          "disabled": true,
          "settings": {
            "title": "Feel weightless when seated in Doro C100",
            "use_h1": false
          }
        },
        "text_JMmVtJ": {
          "type": "text",
          "settings": {
            "text": "<h4>Feel weightless when seated in Doro C100</h4><p>Sihoo Doro C100 ensures optimal weight distribution and pressure reduction on your thighs and hips by emulating the graceful shape of a waterfall. This waterfall-shaped seat suspension prevents any discomfort or heaviness while seated, offering a truly comfortable experience.</p>",
            "enlarge_text": false
