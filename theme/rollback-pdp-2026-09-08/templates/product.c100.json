            "show_in_quickbuy": false
          }
        },
        "accordion_pjxcLm": {
          "type": "accordion",
          "settings": {
            "title": "Promises",
            "icon": "",
            "content": "<p><strong>30-Day Trial</strong><br/><br/>Experience the chair in your own workspace for 30 days—returns accepted within this period.</p><p><strong>3-Year Warranty</strong><br/><br/>Enjoy lasting comfort and peace of mind with our full 3-year warranty.</p><p><strong>Fast Shipping</strong><br/><br/>Receive your chair in just 5–7 business days anywhere in Australia.</p><p><strong>Satisfaction Guarantee</strong><br/><br/>For any issues, contact <a>support@sihoo.com.au</a> for prompt assistance and guaranteed satisfaction.</p>",
